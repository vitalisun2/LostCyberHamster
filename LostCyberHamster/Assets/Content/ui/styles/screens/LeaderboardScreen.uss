.leaderboard-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.leaderboard-screen.leaderboard-screen--rules-open {
    overflow: visible;
}

.main-screen-title--league {
    width: 348.255px;
    background-image: url("/Assets/Content/ui/sprites/league/title_league.png");
}

.leaderboard-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.leaderboard-scale-frame {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1672px;
    height: 821px;
}

.leaderboard-design {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 821px;
    transform-origin: 0 0;
}

.leaderboard-center {
    position: absolute;
    left: 16.666667%;
    top: 140px;
    width: 66.666667%;
    height: 610px;
}

.leaderboard-center__art {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 610px;
    background-image: url("/Assets/Content/ui/sprites/league/panel_league_center.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 64;
    -unity-slice-right: 64;
}

.leaderboard-image-button {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    transition-property: scale, opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.leaderboard-image-button:hover,
.leaderboard-image-button:focus {
    opacity: 0.96;
    scale: 1.02 1.02;
}

.leaderboard-image-button:active {
    opacity: 0.9;
    scale: 0.97 0.97;
}

.leaderboard-location-button:disabled,
.leaderboard-location-button.leaderboard-location-arrow--disabled {
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.leaderboard-location-button {
    position: absolute;
    top: 34px;
    width: 92px;
    height: 90px;
    -unity-background-scale-mode: scale-to-fit;
}

.leaderboard-location-button--previous {
    left: 14.82%;
    background-image: url("/Assets/Content/ui/sprites/league/button_city_previous.png");
}

.leaderboard-location-button--next {
    right: 14.82%;
    background-image: url("/Assets/Content/ui/sprites/league/button_city_next.png");
}

.leaderboard-runtime-text {
    color: rgb(20, 18, 15);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
}

.leaderboard-location-title {
    position: absolute;
    left: 26.51%;
    top: 40px;
    width: 46.98%;
    height: 76px;
    padding-right: 20px;
    padding-left: 20px;
    background-color: rgb(248, 230, 193);
    border-color: rgb(19, 19, 17);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
    font-size: 42px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.leaderboard-time-row {
    position: absolute;
    left: 45px;
    top: 122px;
    right: 45px;
    height: 83px;
    flex-direction: row;
}

.leaderboard-time-slot {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 25%;
    height: 83px;
}

.leaderboard-time-button {
    width: 100%;
    height: 83px;
    padding-right: 8px;
    padding-left: 57px;
    background-image: url("/Assets/Content/ui/sprites/league/button_time_base_blue.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 28;
    -unity-slice-right: 28;
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

.leaderboard-time-button.leaderboard-part--selected {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/league/button_time_base_green.png");
}

.leaderboard-time-button.leaderboard-part--available,
.leaderboard-time-button.leaderboard-part--disabled {
    background-color: rgba(0, 0, 0, 0);
}

.leaderboard-time-button.leaderboard-part--disabled {
    opacity: 0.55;
}

.leaderboard-time-button__icon {
    position: absolute;
    left: 16px;
    top: 14px;
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}

.leaderboard-time-button__icon--morning {
    background-image: url("/Assets/Content/ui/sprites/league/icon_time_morning_sun.png");
}

.leaderboard-time-button__icon--day {
    background-image: url("/Assets/Content/ui/sprites/league/icon_time_day_sun.png");
}

.leaderboard-time-button__icon--evening {
    background-image: url("/Assets/Content/ui/sprites/league/icon_time_evening_sun.png");
}

.leaderboard-time-button__icon--night {
    background-image: url("/Assets/Content/ui/sprites/league/icon_time_night_moon.png");
}

.leaderboard-table {
    position: absolute;
    left: 30px;
    top: 214px;
    right: 34px;
    height: 354px;
}

.leaderboard-table__header,
.leaderboard-current-player {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 56px;
    padding-right: 20px;
    padding-left: 20px;
    flex-direction: row;
    align-items: center;
}

.leaderboard-table__header .leaderboard-runtime-text {
    color: rgb(255, 255, 255);
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
}

.leaderboard-table__rank {
    flex-grow: 0;
    flex-shrink: 0;
    width: 120px;
    font-size: 25px;
    -unity-text-align: middle-center;
}

.leaderboard-table__player {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    padding-left: 18px;
    font-size: 25px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.leaderboard-table__score {
    flex-grow: 0;
    flex-shrink: 0;
    width: 140px;
    font-size: 25px;
    -unity-text-align: middle-right;
}

.leaderboard-table__body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.leaderboard-table__message {
    display: none;
    flex-grow: 1;
    font-size: 27px;
    -unity-text-align: middle-center;
}

#leaderboard__loading {
    display: flex;
}

.leaderboard-table__error {
    display: none;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-right: 24px;
    padding-left: 24px;
}

.leaderboard-table__error-text {
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.leaderboard-status {
    flex-shrink: 0;
    padding: 3px 14px;
    background-color: rgb(248, 232, 199);
}

.leaderboard-status__row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 32px;
}

.leaderboard-status__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 2px 0;
    font-size: 19px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.leaderboard-status__period {
    font-size: 18px;
}

.leaderboard-status__personal {
    padding-top: 3px;
    padding-bottom: 3px;
}

.leaderboard-image-button.leaderboard-status__button {
    flex-shrink: 0;
    width: 176px;
    height: 42px;
    margin-left: 10px;
    padding: 3px 12px;
    background-image: url("/Assets/Content/ui/sprites/settings/button_primary_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    color: rgb(15, 22, 27);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: normal;
}

.leaderboard-status__button.leaderboard-status__button--wide {
    width: 250px;
    min-height: 48px;
}

.leaderboard-image-button.leaderboard-status__button.leaderboard-retry-button {
    width: 240px;
    height: 58px;
    margin-top: 10px;
    margin-left: 0;
    font-size: 22px;
}

.leaderboard-status__button:disabled {
    opacity: 0.55;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.leaderboard-table__rows {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.leaderboard-table__rows .unity-scroll-view__content-container {
    padding: 0;
}

#leaderboard-screen .leaderboard-result-label,
.leaderboard-current-player .leaderboard-runtime-text {
    color: rgb(20, 18, 15);
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
}

#leaderboard-screen .leaderboard-result-row--default {
    background-color: rgb(248, 232, 199);
}

#leaderboard-screen .leaderboard-result-row--current,
.leaderboard-current-player {
    background-color: rgb(255, 203, 70);
}

.leaderboard-current-player {
    display: none;
    border-top-color: rgb(198, 162, 104);
    border-top-width: 2px;
}

#leaderboard-screen .leaderboard-location-arrow--disabled {
    opacity: 0.55;
}

.leaderboard-actions {
    position: absolute;
    left: 16.666667%;
    right: 16.666667%;
    top: 60px;
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.leaderboard-action-button,
.leaderboard-rules-close {
    flex-shrink: 0;
    padding: 4px 20px;
    background-image: url("/Assets/Content/ui/sprites/settings/button_primary_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    color: rgb(15, 22, 27);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: nowrap;
}

.leaderboard-action-button--rules {
    width: 220px;
    height: 52px;
}

.leaderboard-action-button--play {
    width: 320px;
    height: 64px;
    color: rgb(255, 255, 255);
    background-image: url("/Assets/Content/ui/sprites/shared/button_reward_primary_base.png");
    -unity-slice-left: 38;
    -unity-slice-right: 38;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
}

.leaderboard-action-button:disabled {
    opacity: 0.55;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.leaderboard-rules-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.leaderboard-rules-backdrop {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.6);
}

.leaderboard-rules-frame {
    position: relative;
    flex-shrink: 0;
    width: 1672px;
    height: 821px;
}

.leaderboard-rules-design {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 821px;
    transform-origin: 0 0;
    align-items: center;
    justify-content: center;
}

.leaderboard-rules-panel {
    width: 960px;
    height: 680px;
    padding: 28px 40px 32px;
    background-image: url("/Assets/Content/ui/sprites/shared/panel_reward_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.5;
}

.leaderboard-rules-text {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    color: rgb(16, 32, 53);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-outline-width: 0;
    -unity-text-align: upper-left;
    white-space: normal;
}

.leaderboard-rules-title {
    font-size: 32px;
    margin-bottom: 16px;
    -unity-text-align: middle-center;
}

.leaderboard-rules-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    margin: 0;
}

.leaderboard-rules-scroll .unity-scroll-view__content-container {
    padding-right: 14px;
}

.leaderboard-rules-section-title {
    margin-top: 12px;
    margin-bottom: 4px;
    font-size: 24px;
}

.leaderboard-rules-paragraph {
    margin-bottom: 10px;
}

.leaderboard-rules-note {
    margin-top: 10px;
    margin-bottom: 10px;
    font-size: 19px;
}

.leaderboard-rules-close {
    width: 270px;
    height: 58px;
    margin-top: 16px;
    align-self: center;
}
