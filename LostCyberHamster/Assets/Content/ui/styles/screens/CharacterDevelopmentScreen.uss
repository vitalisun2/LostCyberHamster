.development-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: visible;
}

.development-viewport {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.development-scale-frame {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1672px;
    height: 941px;
}

.development-design {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    transform-origin: 0 0;
}

.main-screen-title--skills {
    width: 304.174px;
    background-image: url("/Assets/Content/ui/sprites/skills/title_skills.png");
}

.development-central {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    transform-origin: 836px 498px;
    scale: 1.2 1.2;
}

.development-runtime-text {
    color: rgb(22, 24, 24);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.development-image-button {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    overflow: visible;
    transition-property: scale, opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.development-image-button:hover,
.development-image-button:focus {
    opacity: 0.96;
    scale: 1.02 1.02;
}

.development-image-button:active {
    opacity: 0.9;
    scale: 0.97 0.97;
}

.development-image-button:disabled {
    opacity: 0.62;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.development-cards-background {
    position: absolute;
    left: 125px;
    top: 244px;
    width: 1422px;
    height: 532px;
}

.development-panel {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30px;
    -unity-slice-right: 30px;
    -unity-slice-top: 30px;
    -unity-slice-bottom: 30px;
}

.development-level-panel {
    left: 0;
    top: 0;
    width: 308px;
    height: 520px;
    background-image: url("/Assets/Content/ui/sprites/skills/panel_level_background.png");
}

.development-skins-panel,
.development-abilities-panel {
    left: 316px;
    width: 1106px;
    height: 258px;
}

.development-skins-panel {
    top: 0;
    background-image: url("/Assets/Content/ui/sprites/skills/panel_skins.png");
}

.development-abilities-panel {
    top: 274px;
    background-image: url("/Assets/Content/ui/sprites/skills/panel_abilities.png");
}

.development-line-track {
    position: absolute;
    left: 430px;
    width: 872px;
    height: 23px;
    background-image: url("/Assets/Content/ui/sprites/skills/track_progression.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 12px;
    -unity-slice-right: 12px;
    -unity-slice-top: 10px;
    -unity-slice-bottom: 10px;
}

.development-skins-track {
    top: 81px;
}

.development-abilities-track {
    top: 355px;
}

.development-level-heading-frame {
    position: absolute;
    left: 135px;
    top: 268px;
    width: 289px;
    height: 48px;
    padding-right: 8px;
    padding-left: 8px;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.development-level-heading {
    width: 100%;
    height: 100%;
    font-size: 23px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}

.development-level-value {
    position: absolute;
    left: 215px;
    top: 320px;
    width: 128px;
    height: 118px;
    color: rgb(250, 250, 247);
    font-size: 84px;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(20, 23, 24);
}

.development-xp-heading {
    position: absolute;
    left: 159px;
    top: 438px;
    width: 243px;
    height: 44px;
    font-size: 24px;
}

.development-xp-progress {
    position: absolute;
    left: 159px;
    top: 488px;
    width: 243px;
    height: 45px;
    margin: 0;
    padding: 0;
    background-image: url("/Assets/Content/ui/sprites/skills/progress_bar_empty.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-xp-progress .unity-progress-bar__background {
    height: 45px;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.development-xp-progress .unity-progress-bar__progress {
    height: 39px;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/skills/progress_bar_fill.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 14px;
    -unity-slice-right: 14px;
    -unity-slice-top: 12px;
    -unity-slice-bottom: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.development-xp-progress .unity-progress-bar__title {
    display: none;
}

.development-xp-value {
    position: absolute;
    left: 159px;
    top: 488px;
    width: 243px;
    height: 45px;
    color: rgb(245, 245, 239);
    font-size: 22px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 23, 24);
}

.development-points-heading {
    position: absolute;
    left: 148px;
    top: 558px;
    width: 262px;
    height: 48px;
    font-size: 22px;
}

.development-star {
    position: absolute;
    left: 204px;
    top: 615px;
    width: 62px;
    height: 61px;
    background-image: url("/Assets/Content/ui/sprites/skills/icon_star.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-points-value {
    position: absolute;
    left: 270px;
    top: 604px;
    width: 88px;
    height: 82px;
    color: rgb(250, 250, 247);
    font-size: 62px;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(20, 23, 24);
}

.development-line-tab {
    position: absolute;
    height: 64px;
    padding-right: 13px;
    padding-left: 13px;
    justify-content: center;
    align-items: center;
    -unity-background-image-tint-color: rgb(218, 229, 233);
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.development-skins-tab {
    left: 445px;
    top: 214px;
    width: 216px;
    background-image: url("/Assets/Content/ui/sprites/skills/tab_background_skins.png");
}

.development-abilities-tab {
    left: 445px;
    top: 488px;
    width: 338px;
    background-image: url("/Assets/Content/ui/sprites/skills/tab_background_abilities.png");
}

.development-line-title {
    width: 100%;
    height: 100%;
    font-size: 33px;
    -unity-text-align: middle-center;
}

.development-arrow {
    position: absolute;
    width: 72px;
    height: 98px;
    justify-content: center;
    align-items: center;
}

.development-arrow__icon {
    width: 42px;
    height: 60px;
    -unity-background-scale-mode: scale-to-fit;
}

.development-arrow__icon--left {
    background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_left.png");
}

.development-arrow__icon--right {
    background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_right.png");
}

.development-skin-arrow--left {
    left: 451px;
    top: 288px;
}

.development-skin-arrow--right {
    left: 1465px;
    top: 288px;
}

.development-ability-arrow--left {
    left: 451px;
    top: 562px;
}

.development-ability-arrow--right {
    left: 1465px;
    top: 562px;
}

.development-line-scroll {
    position: absolute;
    left: 535px;
    width: 918px;
    height: 242px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.development-skin-scroll {
    top: 268px;
}

.development-ability-scroll {
    top: 542px;
}

.development-line-scroll .unity-scroll-view__content-viewport,
.development-line-scroll .unity-scroll-view__content-container {
    height: 242px;
}

.development-line-scroll .unity-scroll-view__content-container {
    min-width: 100%;
    flex-direction: row;
    align-items: flex-start;
}

.development-cards {
    flex-shrink: 0;
    min-width: 918px;
    height: 242px;
    flex-direction: row;
    align-items: flex-start;
}

.development-card {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 229.5px;
    height: 242px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.development-card__node {
    position: absolute;
    left: 63.75px;
    top: 0;
    width: 102px;
    height: 102px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.development-card__node--beige,
.development-card__node--gray-blue {
    background-color: rgb(255, 255, 255);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-color: rgb(22, 24, 24);
    border-right-color: rgb(22, 24, 24);
    border-bottom-color: rgb(22, 24, 24);
    border-left-color: rgb(22, 24, 24);
    border-top-left-radius: 51px;
    border-top-right-radius: 51px;
    border-bottom-right-radius: 51px;
    border-bottom-left-radius: 51px;
}

.development-card__icon {
    width: 86px;
    height: 86px;
    -unity-background-scale-mode: scale-to-fit;
}

.development-card--preview .development-card__icon {
    opacity: 1;
}

.development-card__lock {
    width: 49px;
    height: 63px;
    background-image: url("/Assets/Content/ui/sprites/shared/icon_lock.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-card__check {
    position: absolute;
    right: -8px;
    bottom: -7px;
    width: 42px;
    height: 43px;
    background-image: url("/Assets/Content/ui/sprites/skills/icon_check.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-card__name {
    position: absolute;
    left: 0;
    top: 105px;
    width: 229.5px;
    height: 56px;
    color: rgb(22, 24, 24);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    overflow: hidden;
}

.development-card__unlock {
    position: absolute;
    left: 42.25px;
    top: 168px;
    width: 145px;
    height: 74px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/skills/button_unlock_base.png");
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18px;
    -unity-slice-right: 18px;
    -unity-slice-top: 17px;
    -unity-slice-bottom: 17px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    overflow: hidden;
}

.development-card__unlock-action {
    position: absolute;
    left: 0;
    top: 7px;
    width: 145px;
    height: 30px;
    margin: 0;
    padding: 0;
    color: rgb(22, 24, 24);
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.development-card__unlock-cost-row {
    position: absolute;
    left: 0;
    top: 35px;
    width: 145px;
    height: 30px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.development-card__unlock-cost {
    height: 30px;
    margin: 0;
    padding: 0;
    color: rgb(22, 24, 24);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.development-card__unlock-star {
    width: 18px;
    height: 18px;
    margin-left: 3px;
    padding: 0;
    color: rgba(0, 0, 0, 0);
    font-size: 18px;
    background-image: url("/Assets/Content/ui/sprites/skills/icon_star.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.development-equipment-button {
    position: absolute;
    left: 125px;
    top: 790px;
    width: 344px;
    height: 76px;
    background-image: url("/Assets/Content/ui/sprites/skills/button_open_equipment_base.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-equipment-button__icon {
    position: absolute;
    left: 16px;
    top: 12px;
    width: 54px;
    height: 53px;
    background-image: url("/Assets/Content/ui/sprites/skills/icon_equipment.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-equipment-button__label {
    position: absolute;
    left: 79px;
    top: 0;
    width: 256px;
    height: 72px;
    font-size: 21px;
}

.development-info-icon {
    position: absolute;
    left: 493px;
    top: 807px;
    width: 56px;
    height: 51px;
    background-image: url("/Assets/Content/ui/sprites/skills/icon_info.png");
    -unity-background-scale-mode: scale-to-fit;
}

.development-info-text {
    position: absolute;
    left: 559px;
    top: 786px;
    width: 988px;
    height: 106px;
    color: rgb(250, 250, 247);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 23, 24);
}
