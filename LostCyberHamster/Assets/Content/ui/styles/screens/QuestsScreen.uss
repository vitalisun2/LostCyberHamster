.quests-screen {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.main-screen-title--quests {
    width: 331.134px;
    background-image: url("/Assets/Content/ui/sprites/quests/title_quests.png");
}

.quests-content {
    padding-top: 208px;
    min-width: 0;
    min-height: 0;
    align-items: center;
}

.quests-tabs {
    margin-top: 0;
}

.quests-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    padding-right: 22px;
    padding-bottom: 12px;
    padding-left: 22px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.quests-container {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 1032px;
    max-width: 76%;
    height: 410px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.quest-card {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    width: 328px;
    max-width: 32%;
    height: 410px;
    margin-right: 8px;
    margin-left: 8px;
}

.quests-container--story .quest-card {
    max-width: 328px;
    margin-right: 32px;
    margin-left: 32px;
}

.quest-card--first-session .quest-item__frame {
    border-color: rgb(38, 126, 170);
    border-width: 2px;
    border-radius: 20px;
}

.quest-card--first-session-claim .quest-item__reward-action {
    border-color: rgb(41, 144, 180);
    border-width: 2px;
    border-radius: 10px;
}

.quest-card--first-session .quest-item__spacer {
    justify-content: center;
}

.first-session-story-reward {
    margin: 0;
    padding: 0;
    color: rgb(15, 66, 94);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.quests-screen--compact .first-session-story-reward {
    font-size: 13px;
}

.quest-item {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
}

.quest-item__frame {
    width: 100%;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    padding-top: 20px;
    padding-right: 26px;
    padding-bottom: 24px;
    padding-left: 26px;
    background-image: url("/Assets/Content/ui/sprites/quests/quest_card_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
}

.quest-item__image {
    width: 120px;
    height: 126px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.quest-icon--daily {
    background-image: url("/Assets/Content/ui/sprites/quests/quest_icon_daily.png");
}

.quest-icon--story {
    background-image: url("/Assets/Content/ui/sprites/quests/quest_icon_story.png");
}

.quest-item__title {
    width: 100%;
    height: 82px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 4px;
    color: rgb(42, 29, 15);
    font-size: 24px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.quest-item__progress-track {
    width: 251px;
    max-width: 100%;
    height: 35px;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    background-image: url("/Assets/Content/ui/sprites/quests/quest_progress_track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
}

.quest-item__progress-fill {
    position: absolute;
    left: 6px;
    top: 6px;
    height: 23px;
    width: 0;
    background-image: url("/Assets/Content/ui/sprites/shared/progress_fill_blue.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.quest-item .lcs-text.quest-item__progress {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    color: rgb(248, 248, 244);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-item__spacer {
    flex-grow: 1;
    min-height: 8px;
}

.quest-item__reward-action,
.quest-item__reward-claimed {
    width: 250px;
    max-width: 100%;
    height: 61px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.quest-item .lcs_btn.quest-item__reward-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding-left: 18px;
    padding-right: 110px;
    border-width: 0;
    border-radius: 17px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/quests/quest_reward_button.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    color: rgb(250, 250, 242);
    font-size: 20px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-item__reward-button:hover,
.quest-item__reward-button:focus {
    opacity: 0.92;
}

.quest-item__reward-button:active {
    opacity: 0.82;
}

.quest-item__reward-value {
    position: absolute;
    right: 14px;
    top: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.quest-item .quest-item__reward-amount {
    margin-right: 4px;
    color: rgb(250, 250, 242);
    font-size: 20px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-item__reward-image {
    width: 38px;
    height: 38px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.quest-reward-icon--coins {
    background-image: url("/Assets/Content/ui/sprites/quests/quest_reward_coin.png");
}

.quest-reward--disabled {
    opacity: 0.72;
}

.quest-item .lcs_btn.quest-item__reward-button:disabled {
    background-color: rgb(112, 116, 118);
    background-image: none;
}

.quest-item__reward-claimed {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.quest-item__claimed-check {
    margin-right: 8px;
    color: rgb(67, 173, 91);
    font-size: 34px;
    -unity-font-style: bold;
}

.quest-item__claimed-text {
    color: rgb(42, 29, 15);
    font-size: 18px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
}

.quests-screen--compact .quests-tabs {
    width: 610px;
    height: 102px;
}

.quests-screen--compact .quests-content {
    padding-top: 186px;
}

.quests-screen--compact .quests-container {
    height: 328px;
}

.quests-screen--compact .quest-card {
    width: 262px;
    height: 328px;
}

.quests-screen--compact .quests-container--story .quest-card {
    max-width: 262px;
    margin-right: 26px;
    margin-left: 26px;
}

.quests-screen--compact .quest-item__frame {
    padding-top: 14px;
    padding-right: 20px;
    padding-bottom: 17px;
    padding-left: 20px;
}

.quests-screen--compact .quest-item__image {
    width: 94px;
    height: 99px;
}

.quests-screen--compact .quest-item__title {
    height: 64px;
    margin-top: 2px;
    font-size: 19px;
}

.quests-screen--compact .quest-item__progress-track {
    width: 201px;
    height: 28px;
}

.quests-screen--compact .quest-item__progress-fill {
    left: 5px;
    top: 5px;
    height: 18px;
}

.quests-screen--compact .quest-item__progress {
    font-size: 18px;
}

.quests-screen--compact .quest-item__reward-action,
.quests-screen--compact .quest-item__reward-claimed {
    width: 200px;
    height: 49px;
    margin-bottom: 4px;
}

.quests-screen--compact .quest-item__reward-button {
    padding-left: 14px;
    padding-right: 86px;
    font-size: 16px;
}

.quests-screen--compact .quest-item__reward-value {
    right: 11px;
}

.quests-screen--compact .quest-item__reward-amount {
    font-size: 16px;
}

.quests-screen--compact .quest-item__reward-image {
    width: 30px;
    height: 30px;
}



.quests-viewport { flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center; }
.quests-scale-frame { position: relative; flex-shrink: 0; width: 1844px; height: 853px; }
.quests-screen { position: absolute; left: 0; top: 0; width: 1844px; height: 853px; transform-origin: 0 0; }
#questsscreen .quests-content { position: absolute; left: 442px; top: 236px; width: 964px; height: 502px; padding: 0; }
#questsscreen .quests-tabs { width: 700px; height: 98px; flex-shrink: 0; }
#questsscreen .quests-page { width: 100%; margin-top: 20px; padding: 0; }
#questsscreen .quests-container { width: 964px; max-width: 100%; height: 380px; }
#questsscreen .quest-card { width: 302px; max-width: 32%; height: 380px; margin: 0 14px; }
#questsscreen .quest-item__frame { padding: 18px 22px; }
#questsscreen .quest-item__image { width: 105px; height: 110px; }
#questsscreen .quest-item__title { height: 82px; font-size: 24px; }
#questsscreen .carousel-nav-button { position: absolute; bottom: -45px; }
#questsscreen .carousel-nav-button--previous { left: 360px; }
#questsscreen .carousel-nav-button--next { right: 360px; }
.quests-daily-rule-panel { position: absolute; left: 70px; top: 323px; width: 347px; height: 212px; background-image: url("/Assets/Content/ui/sprites/quests/bubble_daily_rule.png"); -unity-background-scale-mode: stretch-to-fill; }
.quests-daily-rule-icon { position: absolute; left: 8px; top: -24px; width: 70px; height: 70px; background-image: url("/Assets/Content/ui/sprites/skills/icon_info.png"); -unity-background-scale-mode: scale-to-fit; }
#questsscreen .quests-daily-rule { position: absolute; left: 31px; right: 25px; top: 44px; height: 123px; margin: 0; color: rgb(42,29,15); font-size: 25px; white-space: normal; -unity-text-align: middle-center; }
.quests-daily-bonus-panel { position: absolute; left: 1500px; top: 340px; width: 239px; height: 332px; }
.quests-daily-pouch { position: absolute; left: 37px; top: 0; width: 176px; height: 145px; background-image: url("/Assets/Content/ui/sprites/shared/retention/icon_coin_pouch.png"); -unity-background-scale-mode: scale-to-fit; }
.quests-daily-tag { position: absolute; left: 0; top: 126px; width: 239px; height: 206px; background-image: url("/Assets/Content/ui/sprites/shared/retention/panel_parchment.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 120; -unity-slice-right: 120; -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: 0.17; }
#questsscreen .quests-daily-bonus-title { position: absolute; left: 10px; right: 10px; top: 11px; height: 43px; margin: 0; font-size: 23px; color: rgb(42,29,15); white-space: normal; -unity-text-align: middle-center; }
.quests-daily-amount-row { position: absolute; left: 28px; right: 28px; top: 52px; height: 42px; flex-direction: row; justify-content: center; align-items: center; }
.quests-daily-coin { width: 34px; height: 34px; margin-right: 7px; background-image: url("/Assets/Content/ui/sprites/shared/hud_coins_icon.png"); -unity-background-scale-mode: scale-to-fit; }
#questsscreen .quests-daily-amount { font-size: 32px; color: rgb(42,29,15); }
.quests-daily-marks { position: absolute; left: 37px; right: 37px; top: 96px; height: 36px; flex-direction: row; justify-content: space-between; }
#questsscreen .quests-daily-mark { width: 36px; height: 36px; margin: 0; border-width: 2px; border-color: rgb(52,70,30); border-radius: 18px; background-color: rgb(234,226,193); color: white; font-size: 29px; -unity-text-align: middle-center; }
#questsscreen .quests-daily-mark--claimed { background-color: rgb(72,148,25); }
#questsscreen .quests-daily-progress { position: absolute; top: 133px; left: 10px; right: 10px; height: 25px; margin: 0; font-size: 17px; color: rgb(42,29,15); -unity-text-align: middle-center; }
#questsscreen .quests-daily-bonus { position: absolute; left: 19px; right: 19px; bottom: 9px; height: 43px; margin: 0; padding: 0; border-width: 0; background-color: transparent; background-image: url("/Assets/Content/ui/sprites/skills/button_unlock_base.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 18; -unity-slice-right: 18; -unity-slice-top: 17; -unity-slice-bottom: 17; color: white; font-size: 24px; -unity-text-align: middle-center; }
#questsscreen .quests-daily-bonus:disabled { opacity: 0.45; }
#questsscreen .quests-daily-more { position: absolute; right: -13px; top: 0; height: 47px; margin: 0; padding: 6px 10px; color: rgb(42,29,15); font-size: 24px; rotate: 9deg; background-image: url("/Assets/Content/ui/sprites/shared/retention/panel_parchment.png"); -unity-background-scale-mode: stretch-to-fill; }

#questsscreen .quests-daily-rule { left: 29px; right: 29px; top: 36px; height: 116px; font-size: 22px; }
#questsscreen .quests-daily-bonus { bottom: 10px; height: 43px; font-size: 22px; -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-scale: 0.5; }
