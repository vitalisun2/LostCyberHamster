.quests-screen {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.quests-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    align-items: center;
}

.quests-title {
    flex-grow: 0;
    flex-shrink: 0;
    width: 369px;
    height: 101px;
    margin-top: 10px;
    background-image: url("/Assets/Content/ui/sprites/quests/title_quests.png");
    -unity-background-scale-mode: scale-to-fit;
}

.quests-tabs {
    margin-top: 32px;
}

.quests-page {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    padding-right: 22px;
    padding-bottom: 12px;
    padding-left: 22px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.quests-container {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 1032px;
    max-width: 76%;
    height: 410px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
}

.quest-card {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    width: 328px;
    max-width: 32%;
    height: 410px;
    margin-right: 8px;
    margin-left: 8px;
}

.quests-container--story .quest-card {
    max-width: 328px;
    margin-right: 32px;
    margin-left: 32px;
}

.quest-item {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
}

.quest-item__frame {
    width: 100%;
    height: 100%;
    flex-grow: 0;
    flex-shrink: 0;
    align-items: center;
    padding-top: 20px;
    padding-right: 26px;
    padding-bottom: 24px;
    padding-left: 26px;
    background-image: url("/Assets/Content/ui/sprites/quests/quest_card_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 42;
}

.quest-item__image {
    width: 120px;
    height: 126px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.quest-icon--daily {
    background-image: url("/Assets/Content/ui/sprites/quests/quest_icon_daily.png");
}

.quest-icon--story {
    background-image: url("/Assets/Content/ui/sprites/quests/quest_icon_story.png");
}

.quest-item__title {
    width: 100%;
    height: 82px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 4px;
    color: rgb(42, 29, 15);
    font-size: 24px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.quest-item__progress-track {
    width: 251px;
    max-width: 100%;
    height: 35px;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
    background-image: url("/Assets/Content/ui/sprites/quests/quest_progress_track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 10;
    -unity-slice-bottom: 10;
}

.quest-item__progress-fill {
    position: absolute;
    left: 6px;
    top: 6px;
    height: 23px;
    width: 0;
    background-image: url("/Assets/Content/ui/sprites/shared/progress_fill_blue.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.quest-item .lcs-text.quest-item__progress {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    color: rgb(248, 248, 244);
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-item__spacer {
    flex-grow: 1;
    min-height: 8px;
}

.quest-item__reward-action,
.quest-item__reward-claimed {
    width: 250px;
    max-width: 100%;
    height: 61px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.quest-item .lcs_btn.quest-item__reward-button {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding-left: 18px;
    padding-right: 110px;
    border-width: 0;
    border-radius: 17px;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/quests/quest_reward_button.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    color: rgb(250, 250, 242);
    font-size: 20px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-item__reward-button:hover,
.quest-item__reward-button:focus {
    opacity: 0.92;
}

.quest-item__reward-button:active {
    opacity: 0.82;
}

.quest-item__reward-value {
    position: absolute;
    right: 14px;
    top: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.quest-item .quest-item__reward-amount {
    margin-right: 4px;
    color: rgb(250, 250, 242);
    font-size: 20px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
}

.quest-item__reward-image {
    width: 38px;
    height: 38px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.quest-reward-icon--coins {
    background-image: url("/Assets/Content/ui/sprites/quests/quest_reward_coin.png");
}

.quest-reward--disabled {
    opacity: 0.72;
}

.quest-item .lcs_btn.quest-item__reward-button:disabled {
    background-color: rgb(112, 116, 118);
    background-image: none;
}

.quest-item__reward-claimed {
    display: none;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.quest-item__claimed-check {
    margin-right: 8px;
    color: rgb(67, 173, 91);
    font-size: 34px;
    -unity-font-style: bold;
}

.quest-item__claimed-text {
    color: rgb(42, 29, 15);
    font-size: 18px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
}

.quests-screen--compact .quests-title {
    width: 295px;
    height: 81px;
    margin-top: 4px;
}

.quests-screen--compact .quests-tabs {
    width: 530px;
    height: 89px;
    margin-top: 10px;
}

.quests-screen--compact .quests-container {
    height: 328px;
}

.quests-screen--compact .quest-card {
    width: 262px;
    height: 328px;
}

.quests-screen--compact .quests-container--story .quest-card {
    max-width: 262px;
    margin-right: 26px;
    margin-left: 26px;
}

.quests-screen--compact .quest-item__frame {
    padding-top: 14px;
    padding-right: 20px;
    padding-bottom: 17px;
    padding-left: 20px;
}

.quests-screen--compact .quest-item__image {
    width: 94px;
    height: 99px;
}

.quests-screen--compact .quest-item__title {
    height: 64px;
    margin-top: 2px;
    font-size: 19px;
}

.quests-screen--compact .quest-item__progress-track {
    width: 201px;
    height: 28px;
}

.quests-screen--compact .quest-item__progress-fill {
    left: 5px;
    top: 5px;
    height: 18px;
}

.quests-screen--compact .quest-item__progress {
    font-size: 18px;
}

.quests-screen--compact .quest-item__reward-action,
.quests-screen--compact .quest-item__reward-claimed {
    width: 200px;
    height: 49px;
    margin-bottom: 4px;
}

.quests-screen--compact .quest-item__reward-button {
    padding-left: 14px;
    padding-right: 86px;
    font-size: 16px;
}

.quests-screen--compact .quest-item__reward-value {
    right: 11px;
}

.quests-screen--compact .quest-item__reward-amount {
    font-size: 16px;
}

.quests-screen--compact .quest-item__reward-image {
    width: 30px;
    height: 30px;
}
