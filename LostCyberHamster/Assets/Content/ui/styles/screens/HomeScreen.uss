.home-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.home-runtime-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.home-hud {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 86px;
    min-height: 86px;
    max-height: 86px;
}

.home-hud__lane {
    padding-right: 24px;
    padding-left: 24px;
}

.home-hud__side {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    min-width: 0;
    flex-direction: row;
}

.home-hud__left {
    justify-content: flex-start;
    gap: 10px;
}

.home-hud__right {
    justify-content: flex-end;
}

.home-image-button {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    overflow: visible;
    transition-property: scale, opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.home-image-button:hover,
.home-image-button:focus {
    opacity: 0.96;
    scale: 1.02 1.02;
}

.home-image-button:active {
    opacity: 0.9;
    scale: 0.97 0.97;
}

.home-xp-panel {
    position: absolute;
    left: 50%;
    top: 0;
    flex-grow: 0;
    flex-shrink: 0;
    width: 385px;
    min-width: 385px;
    max-width: 385px;
    height: 86px;
    margin-left: -192.5px;
}

.home-xp-panel__track {
    position: absolute;
    left: 61px;
    top: 14px;
    width: 324px;
    height: 58px;
    background-image: url("/Assets/Content/ui/sprites/home/hud_player_level_track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 25px;
    -unity-slice-right: 25px;
    -unity-slice-top: 14px;
    -unity-slice-bottom: 14px;
}

.home-xp-panel__fill-clip {
    position: absolute;
    left: 69px;
    top: 22px;
    width: 308px;
    height: 42px;
    overflow: hidden;
}

.home-xp-panel__fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    min-width: 0;
    height: 42px;
    background-image: url("/Assets/Content/ui/sprites/home/hud_player_level_fill.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 9px;
    -unity-slice-right: 9px;
    -unity-slice-top: 9px;
    -unity-slice-bottom: 9px;
}

.home-xp-panel__badge {
    position: absolute;
    left: 0;
    top: 0;
    width: 88px;
    height: 85px;
    justify-content: center;
    align-items: center;
    background-image: url("/Assets/Content/ui/sprites/home/hud_player_level_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home-xp-panel__level {
    width: 58px;
    height: 58px;
    margin-top: -2px;
    font-size: 39px;
    -unity-text-outline-width: 3px;
}

.home-xp-panel__level--compact {
    font-size: 26px;
    -unity-text-outline-width: 0;
}

.home-xp-panel__label {
    position: absolute;
    left: 61px;
    top: 22px;
    width: 324px;
    height: 42px;
    font-size: 27px;
    -unity-text-outline-width: 0;
}

.home-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
    padding-right: 6%;
    padding-left: 6%;
    flex-direction: row;
    align-items: stretch;
}

.home-main__logo-column,
.home-main__actions {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    min-width: 0;
    min-height: 0;
    justify-content: center;
    align-items: center;
}

.home-main__logo-column {
    padding-right: 3%;
}

.home-main__actions {
    padding-left: 3%;
}

.home-logo {
    width: 100%;
    height: 88%;
    max-width: 600px;
    max-height: 440px;
    background-image: url("/Assets/Content/ui/sprites/home/logo_lost_cyber_hamster.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home-play-button {
    width: 78%;
    height: 48%;
    min-height: 118px;
    max-width: 528px;
    max-height: 244px;
    margin-bottom: 16px;
    background-image: url("/Assets/Content/ui/sprites/home/button_play.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home-select-level-button {
    width: 58%;
    height: 23%;
    min-height: 66px;
    max-width: 396px;
    max-height: 110px;
    margin-top: 8px;
    background-image: url("/Assets/Content/ui/sprites/home/button_select_level.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home-navigation {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 24%;
    min-height: 130px;
    max-height: 205px;
    padding-bottom: 5px;
    justify-content: flex-end;
    align-items: center;
}

.home-navigation__buttons {
    flex-grow: 1;
    flex-shrink: 1;
    width: 52%;
    min-width: 660px;
    max-width: 850px;
    height: 100%;
    max-height: 150px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
}

.home-navigation__button {
    flex-grow: 0;
    flex-shrink: 1;
    width: 19%;
    height: 100%;
    max-width: 147px;
    max-height: 140px;
    -unity-background-scale-mode: scale-to-fit;
}

.home-navigation__shop {
    background-image: url("/Assets/Content/ui/sprites/home/nav_shop.png");
}

.home-navigation__hero {
    background-image: url("/Assets/Content/ui/sprites/home/nav_hero.png");
}

.home-navigation__skills {
    background-image: url("/Assets/Content/ui/sprites/home/nav_skills.png");
}

.home-navigation__quests {
    background-image: url("/Assets/Content/ui/sprites/home/nav_quests.png");
}

.home-navigation__league {
    background-image: url("/Assets/Content/ui/sprites/home/nav_league.png");
}
