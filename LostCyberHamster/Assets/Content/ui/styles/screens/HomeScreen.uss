.home-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.home-runtime-text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.home-hud {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 86px;
    min-height: 86px;
    max-height: 86px;
}

.home-hud__lane {
    padding-right: 24px;
    padding-left: 24px;
}

.home-hud__side {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    min-width: 0;
    flex-direction: row;
}

.home-hud__left {
    justify-content: flex-start;
    gap: 10px;
}

.home-hud__right {
    justify-content: flex-end;
}

.home-image-button {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    overflow: visible;
    transition-property: scale, opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.home-image-button:hover,
.home-image-button:focus {
    opacity: 0.96;
    scale: 1.02 1.02;
}

.home-image-button:active {
    opacity: 0.9;
    scale: 0.97 0.97;
}

.home-xp-panel {
    position: absolute;
    left: 50%;
    top: 0;
    flex-grow: 0;
    flex-shrink: 0;
    width: 385px;
    min-width: 385px;
    max-width: 385px;
    height: 86px;
    margin-left: -192.5px;
}

.home-xp-panel__track {
    position: absolute;
    left: 61px;
    top: 14px;
    width: 324px;
    height: 58px;
    background-image: url("/Assets/Content/ui/sprites/home/hud_player_level_track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 25px;
    -unity-slice-right: 25px;
    -unity-slice-top: 14px;
    -unity-slice-bottom: 14px;
}

.home-xp-panel__fill-clip {
    position: absolute;
    left: 69px;
    top: 22px;
    width: 308px;
    height: 42px;
    overflow: hidden;
}

.home-xp-panel__fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    min-width: 0;
    height: 42px;
    background-image: url("/Assets/Content/ui/sprites/home/hud_player_level_fill.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 9px;
    -unity-slice-right: 9px;
    -unity-slice-top: 9px;
    -unity-slice-bottom: 9px;
}

.home-xp-panel__badge {
    position: absolute;
    left: 0;
    top: 0;
    width: 88px;
    height: 85px;
    justify-content: center;
    align-items: center;
    background-image: url("/Assets/Content/ui/sprites/home/hud_player_level_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

.home-xp-panel__level {
    width: 58px;
    height: 58px;
    margin-top: -2px;
    font-size: 39px;
    -unity-text-outline-width: 3px;
}

.home-xp-panel__level--compact {
    font-size: 26px;
    -unity-text-outline-width: 0;
}

.home-xp-panel__label {
    position: absolute;
    left: 61px;
    top: 22px;
    width: 324px;
    height: 42px;
    font-size: 27px;
    -unity-text-outline-width: 0;
}

.home-viewport { flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center; }
.home-scale-frame { position: relative; flex-shrink: 0; width: 1844px; height: 853px; }
.home-screen { position: absolute; left: 0; top: 0; width: 1844px; height: 853px; transform-origin: 0 0; overflow: visible; }
.home-hud { position: absolute; top: 0; left: 0; }
.home-hud__lane { padding-left: 96px; padding-right: 96px; }
.home-goal-slot { position: absolute; left: 160px; top: 263px; width: 490px; height: 320px; }
.home-logo { position: absolute; left: 735px; top: 91px; width: 380px; height: 251px; background-image: url("/Assets/Content/ui/sprites/home/logo_lost_cyber_hamster.png"); -unity-background-scale-mode: scale-to-fit; }
#homescreen .home-play-button { position: absolute; left: 700px; top: 350px; width: 445px; height: 166px; background-image: url("/Assets/Content/ui/sprites/shared/next_goal/goal_header.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 220; -unity-slice-right: 220; -unity-slice-top: 220; -unity-slice-bottom: 220; -unity-slice-scale: 0.11; color: white; font-size: 86px; -unity-text-outline-width: 6px; -unity-text-outline-color: black; -unity-font-style: bold; }
#homescreen .home-select-level-button { position: absolute; left: 751px; top: 531px; width: 343px; height: 73px; background-image: url("/Assets/Content/ui/sprites/hero/button_select_base.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 30; -unity-slice-right: 30; -unity-slice-top: 24; -unity-slice-bottom: 24; color: white; font-size: 30px; -unity-text-outline-width: 2px; -unity-text-outline-color: black; }
.home-navigation { position: absolute; left: 510px; top: 680px; width: 830px; height: 140px; }
.home-navigation__buttons { width: 100%; height: 100%; flex-direction: row; justify-content: space-between; align-items: flex-end; }
.home-navigation__button { width: 145px; height: 140px; -unity-background-scale-mode: scale-to-fit; }
.home-navigation__shop {
    background-image: url("/Assets/Content/ui/sprites/home/nav_shop.png");
}

.home-navigation__hero {
    background-image: url("/Assets/Content/ui/sprites/home/nav_hero.png");
}

.home-navigation__skills {
    background-image: url("/Assets/Content/ui/sprites/home/nav_skills.png");
}

.home-navigation__quests {
    background-image: url("/Assets/Content/ui/sprites/home/nav_quests.png");
}

.home-navigation__league {
    background-image: url("/Assets/Content/ui/sprites/home/nav_league.png");
}


.return-home { position: absolute; left: 1190px; top: 279px; width: 520px; }
#homescreen .return-home__row { position: relative; width: 520px; height: 137px; margin: 0 0 21px; padding: 0; border-width: 0; background-color: transparent; background-image: url("/Assets/Content/ui/sprites/shared/retention/panel_parchment.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 120; -unity-slice-right: 120; -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: 0.24; }
.return-home__icon { position: absolute; left: 15px; top: 4px; width: 122px; height: 122px; -unity-background-scale-mode: scale-to-fit; }
.return-home__icon--cycle { background-image: url("/Assets/Content/ui/sprites/shared/retention/icon_victory_stamp.png"); }
.return-home__icon--week { background-image: url("/Assets/Content/ui/sprites/shared/retention/icon_calendar.png"); }
#homescreen .return-home__title { position: absolute; left: 143px; right: 77px; top: 21px; height: 40px; margin: 0; color: rgb(13,32,48); font-size: 28px; -unity-text-align: middle-left; white-space: normal; }
#homescreen .return-home__progress { position: absolute; left: 143px; right: 77px; top: 64px; height: 42px; margin: 0; color: rgb(13,32,48); font-size: 24px; -unity-text-align: middle-left; }
.return-home__arrow { position: absolute; right: 23px; top: 33px; width: 52px; height: 66px; background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_right.png"); -unity-background-scale-mode: scale-to-fit; }
#homescreen .return-home__ready { position: absolute; right: 53px; top: -12px; margin: 0; padding: 2px 12px; color: white; background-color: rgb(58,126,32); border-color: rgb(19,49,25); border-width: 2px; border-radius: 9px; font-size: 19px; rotate: 3deg; }
#homescreen .return-home__status { margin: 0 12px; color: white; font-size: 18px; white-space: normal; -unity-text-align: middle-center; -unity-text-outline-width: 1px; -unity-text-outline-color: black; }
.return-home__row:hover { scale: 1.015 1.015; }
.return-home__row:active { scale: 0.985 0.985; }

#homescreen .home-play-button, #homescreen .home-select-level-button, #homescreen .return-home__title, #homescreen .return-home__progress { -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf"); -unity-font-style: bold; }
#homescreen .home-play-button { -unity-text-outline-width: 2px; font-size: 82px; }
#homescreen .home-select-level-button { -unity-text-outline-width: 1px; font-size: 27px; }
#homescreen .return-home__arrow { width: 59px; height: 73px; right: 22px; top: 29px; margin: 0; padding: 0 0 8px; color: white; font-size: 73px; -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf"); -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: black; background-image: url("/Assets/Content/ui/sprites/hero/button_select_base.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 30; -unity-slice-right: 30; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-scale: 0.75; }
#homescreen .return-calendar-day { margin: 0; width: 122px; height: 122px; padding-top: 20px; color: rgb(13,32,48); font-size: 63px; -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf"); -unity-text-align: middle-center; rotate: -8deg; }
