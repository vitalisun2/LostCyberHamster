.hero-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

.hero-viewport {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hero-scale-frame {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1672px;
    height: 941px;
}

.hero-design {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    transform-origin: 0 0;
}

.main-screen-title--hero {
    width: 256.348px;
    background-image: url("/Assets/Content/ui/sprites/hero/title_hero.png");
}

.hero-tabs {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    top: 269px;
}

.hero-tab__icon {
    position: absolute;
    left: 18px;
    top: 22px;
    width: 55px;
    height: 54px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-tab__icon--skins {
    background-image: url("/Assets/Content/ui/sprites/hero/tab_icon_skins.png");
}

.hero-tab__icon--abilities {
    background-image: url("/Assets/Content/ui/sprites/hero/tab_icon_abilities.png");
}

.hero-tab__label {
    left: 78px;
    width: 253px;
}

.hero-content {
    position: absolute;
    left: 16.666667%;
    top: 400px;
    width: 66.666667%;
    height: 473px;
}

.hero-page {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 473px;
}

.hero-page--abilities {
    display: none;
}

.hero-preview-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 44.28%;
    height: 473px;
    background-image: url("/Assets/Content/ui/sprites/hero/panel_preview_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
}

.hero-skin-preview-image {
    position: absolute;
    left: 10%;
    top: 82px;
    width: 80%;
    height: 284px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-preview-name {
    position: absolute;
    left: 7%;
    bottom: 34px;
    width: 86%;
    height: 55px;
    color: rgb(19, 23, 25);
    font-size: 35px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-ability-preview-image {
    position: absolute;
    left: 10%;
    top: 66px;
    width: 80%;
    height: 214px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-ability-description {
    position: absolute;
    left: 12%;
    top: 278px;
    width: 76%;
    height: 112px;
    color: rgb(19, 23, 25);
    font-size: 27px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-select-button,
.hero-slot__action {
    margin: 0;
    padding: 0 12px 0 12px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/hero/button_select_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 25px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-select-button {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 28px;
    width: 220px;
    height: 68px;
}

.hero-select-button:disabled {
    opacity: 0.6;
}

.hero-slots-scroll {
    position: absolute;
    left: 46.05%;
    top: 0;
    width: 53.95%;
    height: 473px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

.hero-slots-scroll .unity-scroll-view__content-viewport {
    width: 100%;
    overflow: hidden;
}

.hero-slots-scroll .unity-scroll-view__content-container {
    width: 100%;
}

.hero-slots {
    flex-shrink: 0;
    width: 100%;
}

.hero-slot {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 149px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/hero/slot_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 32;
    -unity-slice-bottom: 32;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hero-slot--spaced {
    margin-top: 13px;
}

.hero-slot--selected {
    -unity-background-image-tint-color: rgb(235, 250, 255);
}

.hero-slot__icon {
    position: absolute;
    left: 24px;
    top: 22px;
    width: 148px;
    height: 106px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-slot__name {
    position: absolute;
    left: 177px;
    top: 23px;
    width: 254px;
    height: 104px;
    color: rgb(18, 22, 24);
    font-size: 29px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
}

.hero-slot__lock {
    position: absolute;
    left: 249px;
    top: 34px;
    width: 76px;
    height: 81px;
    background-image: url("/Assets/Content/ui/sprites/hero/state_locked.png");
    -unity-background-scale-mode: scale-to-fit;
}

.hero-slot__check {
    position: absolute;
    right: 23px;
    top: 35px;
    width: 78px;
    height: 79px;
    background-image: url("/Assets/Content/ui/sprites/hero/state_selected_check.png");
    -unity-background-scale-mode: scale-to-fit;
}

.hero-slot__action {
    position: absolute;
    right: 20px;
    top: 43px;
    width: 185px;
    height: 64px;
}

.hero-slot__action--price {
    padding-left: 44px;
    color: rgb(255, 255, 255);
    background-image: url("/Assets/Content/ui/sprites/hero/button_price_base.png");
    -unity-slice-left: 32;
    -unity-slice-right: 32;
    -unity-slice-top: 26;
    -unity-slice-bottom: 26;
    font-size: 29px;
}

.hero-slot__price-icon {
    position: absolute;
    left: 11px;
    top: 8px;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-scroll-button {
    position: absolute;
    right: 20.85%;
    width: 64px;
    height: 48px;
    margin: 0;
    padding: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hero-scroll-button--up {
    top: 344px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_up.png");
}

.hero-scroll-button--down {
    top: 881px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_down.png");
}

.hero-scroll-button:disabled,
.hero-scroll-button:hover,
.hero-scroll-button:active,
.hero-scroll-button:focus,
.hero-scroll-button:disabled:hover,
.hero-scroll-button:disabled:active,
.hero-scroll-button:disabled:focus {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hero-scroll-button:disabled {
    opacity: 0.45;
}

.progression-return {
    position: absolute; left: 1180px; top: 190px; width: 280px; height: 64px;
    background-color: rgb(74, 126, 156); border-radius: 16px;
    color: white; font-size: 26px; -unity-font-style: bold;
}

#hero-screen .hero-ability-tier { position: absolute; left: 26px; top: 18px; width: 58px; height: 60px; margin: 0; border-width: 3px; border-color: rgb(22,24,24); border-radius: 30px; background-image: url("/Assets/Content/ui/sprites/shared/next_goal/goal_header.png"); -unity-background-scale-mode: stretch-to-fill; color: rgb(13,32,48); font-size: 38px; -unity-text-align: middle-center; }
#hero-screen .hero-ability-name { position: absolute; left: 97px; right: 18px; top: 14px; height: 73px; margin: 0; color: rgb(13,32,48); font-size: 30px; white-space: normal; -unity-text-align: middle-left; }
.hero-ability-preview-image { top: 82px; height: 180px; }
#hero-screen .hero-ability-description { left: 6%; width: 88%; top: 268px; height: 96px; font-size: 23px; color: rgb(13,32,48); }
#hero-screen .hero-ability-upgrade { position: absolute; left: 5%; bottom: 35px; width: 54%; height: 78px; margin: 0; padding: 0 70px 0 13px; border-width: 0; background-color: transparent; background-image: url("/Assets/Content/ui/sprites/skills/button_unlock_base.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 18; -unity-slice-right: 18; -unity-slice-top: 17; -unity-slice-bottom: 17; color: rgb(13,32,48); font-size: 26px; white-space: normal; -unity-text-align: middle-center; }
#hero-screen .hero-ability-upgrade--maximum { padding-right: 13px; }
#hero-screen .hero-upgrade-price { position: absolute; right: 12px; top: 15px; height: 47px; margin: 0; color: rgb(13,32,48); font-size: 29px; -unity-text-align: middle-center; }
#hero-screen #hero-ability-select { left: 63%; bottom: 39px; width: 32%; height: 70px; translate: 0 0; font-size: 23px; padding: 0 7px; }
#hero-screen .hero-select-button--selected { background-image: none; background-color: rgb(212,231,191); border-width: 2px; border-radius: 14px; border-color: rgb(50,111,35); color: rgb(24,48,22); opacity: 1; }

#hero-abilities-page .hero-slot__name { width: auto; right: 110px; font-size: 28px; }
