.hero-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
}

.hero-viewport {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.hero-scale-frame {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1672px;
    height: 941px;
}

.hero-design {
    position: absolute;
    left: 0;
    top: 0;
    width: 1672px;
    height: 941px;
    transform-origin: 0 0;
}

.hero-hud {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 0;
    width: auto;
}

.hero-hud__left,
.hero-hud__right {
    flex-direction: row;
    gap: 12px;
}

.hero-hud__spacer {
    flex-grow: 1;
}

.hero-title {
    position: absolute;
    left: 704px;
    top: 176px;
    width: 264px;
    height: 88px;
    background-image: url("/Assets/Content/ui/sprites/hero/title_hero.png");
    -unity-background-scale-mode: scale-to-fit;
}

.hero-tabs {
    position: absolute;
    left: 529px;
    top: 318px;
    width: 615px;
    height: 69px;
    flex-direction: row;
    gap: 42px;
}

.hero-tab {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 286px;
    height: 69px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/hero/tab_base_inactive.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 32px;
    -unity-slice-right: 32px;
    -unity-slice-top: 24px;
    -unity-slice-bottom: 24px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hero-tab--active {
    background-image: url("/Assets/Content/ui/sprites/hero/tab_base_active.png");
}

.hero-tab__icon {
    position: absolute;
    left: 28px;
    top: 11px;
    width: 48px;
    height: 47px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-tab__icon--skins {
    background-image: url("/Assets/Content/ui/sprites/hero/tab_icon_skins.png");
}

.hero-tab__icon--abilities {
    background-image: url("/Assets/Content/ui/sprites/hero/tab_icon_abilities.png");
}

.hero-tab__label {
    position: absolute;
    left: 76px;
    top: 5px;
    width: 200px;
    height: 57px;
    color: rgb(18, 21, 23);
    font-size: 24px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-content {
    position: absolute;
    left: 328px;
    top: 400px;
    width: 1075px;
    height: 473px;
}

.hero-page {
    position: absolute;
    left: 0;
    top: 0;
    width: 1075px;
    height: 473px;
}

.hero-page--abilities {
    display: none;
}

.hero-preview-panel {
    position: absolute;
    left: 0;
    top: 0;
    width: 476px;
    height: 473px;
    background-image: url("/Assets/Content/ui/sprites/hero/panel_preview_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 48px;
    -unity-slice-right: 48px;
    -unity-slice-top: 48px;
    -unity-slice-bottom: 48px;
}

.hero-skin-preview-image {
    position: absolute;
    left: 47px;
    top: 82px;
    width: 382px;
    height: 284px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-preview-name {
    position: absolute;
    left: 35px;
    bottom: 34px;
    width: 406px;
    height: 55px;
    color: rgb(19, 23, 25);
    font-size: 35px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-ability-preview-image {
    position: absolute;
    left: 48px;
    top: 66px;
    width: 380px;
    height: 214px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-ability-description {
    position: absolute;
    left: 56px;
    top: 278px;
    width: 364px;
    height: 112px;
    color: rgb(19, 23, 25);
    font-size: 27px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-select-button,
.hero-slot__action {
    margin: 0;
    padding: 0 12px 0 12px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/hero/button_select_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30px;
    -unity-slice-right: 30px;
    -unity-slice-top: 24px;
    -unity-slice-bottom: 24px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 25px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.hero-select-button {
    position: absolute;
    left: 128px;
    bottom: 28px;
    width: 220px;
    height: 68px;
}

.hero-select-button:disabled {
    opacity: 0.6;
}

.hero-slots-scroll {
    position: absolute;
    left: 495px;
    top: 7px;
    width: 580px;
    height: 466px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.hero-slots-scroll .unity-scroll-view__content-viewport,
.hero-slots-scroll .unity-scroll-view__content-container {
    width: 580px;
}

.hero-slots {
    flex-shrink: 0;
    width: 574px;
    gap: 14px;
}

.hero-slot {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 574px;
    height: 140px;
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/hero/slot_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40px;
    -unity-slice-right: 40px;
    -unity-slice-top: 32px;
    -unity-slice-bottom: 32px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hero-slot--selected {
    -unity-background-image-tint-color: rgb(235, 250, 255);
}

.hero-slot__icon {
    position: absolute;
    left: 24px;
    top: 16px;
    width: 148px;
    height: 106px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-slot__name {
    position: absolute;
    left: 177px;
    top: 18px;
    width: 254px;
    height: 104px;
    color: rgb(18, 22, 24);
    font-size: 29px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 0;
}

.hero-slot__lock {
    position: absolute;
    left: 249px;
    top: 30px;
    width: 76px;
    height: 81px;
    background-image: url("/Assets/Content/ui/sprites/hero/state_locked.png");
    -unity-background-scale-mode: scale-to-fit;
}

.hero-slot__check {
    position: absolute;
    right: 23px;
    top: 31px;
    width: 78px;
    height: 79px;
    background-image: url("/Assets/Content/ui/sprites/hero/state_selected_check.png");
    -unity-background-scale-mode: scale-to-fit;
}

.hero-slot__action {
    position: absolute;
    right: 20px;
    top: 41px;
    width: 185px;
    height: 64px;
}

.hero-slot__action--price {
    padding-left: 44px;
    color: rgb(255, 255, 255);
    background-image: url("/Assets/Content/ui/sprites/hero/button_price_base.png");
    -unity-slice-left: 32px;
    -unity-slice-right: 32px;
    -unity-slice-top: 26px;
    -unity-slice-bottom: 26px;
    font-size: 29px;
}

.hero-slot__price-icon {
    position: absolute;
    left: 11px;
    top: 8px;
    width: 48px;
    height: 48px;
    -unity-background-scale-mode: scale-to-fit;
}

.hero-scroll-button {
    position: absolute;
    left: 1269px;
    width: 64px;
    height: 48px;
    margin: 0;
    padding: 0;
    display: none;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.hero-scroll-button--up {
    top: 351px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_up.png");
}

.hero-scroll-button--down {
    top: 881px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_scroll_down.png");
}

.hero-scroll-button:disabled {
    opacity: 0.45;
}
