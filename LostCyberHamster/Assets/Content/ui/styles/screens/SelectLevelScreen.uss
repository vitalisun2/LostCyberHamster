.level-card {
    background-color: var(--ui-level-card-shell);
    border-color: var(--ui-border);
}

.level-card > .level-card__content {
    background-color: var(--ui-content-card-surface-solid);
    border-color: var(--ui-border);
}

.level-card__title {
    color: var(--ui-content-card-accent);
    -unity-text-outline-width: 0;
}

.select-level-screen {
    min-width: 0;
    min-height: 0;
}

.select-level__content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    padding-top: 4px;
    padding-right: 24px;
    padding-bottom: 12px;
    padding-left: 24px;
    align-items: center;
}

.select-level__title {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    min-height: 60px;
    max-height: 80px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 4px;
    margin-left: 0;
    font-size: 52px;
    -unity-text-align: middle-center;
}

.select-level__preview-row {
    flex-grow: 4;
    flex-shrink: 1;
    min-width: 0;
    min-height: 180px;
    width: 100%;
    height: 42%;
    max-height: 420px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.select-level__location-image {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 300px;
    width: 60%;
    max-width: 960px;
    height: 100%;
    max-height: 420px;
    margin-right: 8px;
    margin-left: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.select-level__arrow {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 150px;
    width: 220px;
    max-width: 220px;
    min-height: 130px;
    height: 180px;
    max-height: 180px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    font-size: 76px;
}

.select-level__arrow--previous {
    margin-right: 12px;
    margin-left: 0;
}

.select-level__arrow--next {
    margin-right: 0;
    margin-left: 12px;
}

.select-level__cards {
    flex-grow: 5;
    flex-shrink: 1;
    min-width: 0;
    min-height: 320px;
    width: 75%;
    max-width: 1120px;
    padding-top: 12px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    flex-direction: row;
    justify-content: space-around;
    align-self: center;
    align-items: center;
}
