/* Tutorial HUD: геометрия ввода остаётся в локальных единицах root. */
#tutorial-root,
#tutorial-root .tutorial-fill,
#tutorial-complete-root {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
}

#tutorial-root #tutorial-idle-input-blocker,
#tutorial-root #tutorial-prompt-input-capture,
#tutorial-root #tutorial-focus-highlight {
    background-color: transparent;
}

#tutorial-root #tutorial-focus-highlight {
    position: absolute;
}

#tutorial-root #tutorial-header,
#tutorial-root #tutorial-instruction-bubble,
#tutorial-root #tutorial-finger,
#tutorial-root #tutorial-skip {
    position: absolute;
    transform-origin: 0 0;
    flex-shrink: 0;
}

#tutorial-root .unity-label {
    margin: 0;
    padding: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(25, 53, 70);
    -unity-text-outline-width: 0;
}

#tutorial-root #tutorial-header {
    width: 200px;
    height: 90px;
}

#tutorial-root #tutorial-title {
    position: absolute;
    left: 0;
    top: 0;
    width: 200px;
    height: 40px;
    font-size: 28px;
    color: rgb(255, 243, 212);
    -unity-text-outline-color: rgb(23, 24, 27);
    -unity-text-outline-width: 2px;
}

#tutorial-root #tutorial-lesson-panel {
    position: absolute;
    top: 42px;
    left: 16px;
    width: 168px;
    height: 48px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_hud_lesson_panel.png");
    -unity-background-scale-mode: stretch-to-fill;
}

#tutorial-root #tutorial-lesson-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 32px;
    height: 32px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_hud_lesson_badge.png");
    -unity-background-scale-mode: scale-to-fit;
}

#tutorial-root #tutorial-lesson-number {
    width: 32px;
    height: 30px;
    font-size: 19px;
    color: rgb(255, 243, 212);
    -unity-text-outline-color: rgb(35, 34, 35);
    -unity-text-outline-width: 1px;
}

#tutorial-root #tutorial-lesson-title {
    position: absolute;
    left: 44px;
    top: 7px;
    width: 114px;
    height: 33px;
    font-size: 12px;
}

#tutorial-root #tutorial-instruction-bubble {
    width: 228px;
    height: 88px;
    padding: 10px 15px 11px 15px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_hud_instruction_panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    justify-content: center;
    align-items: center;
}

#tutorial-root #tutorial-instruction {
    width: 198px;
    height: 67px;
    font-size: 16px;
}

#tutorial-root #tutorial-finger {
    width: 56px;
    height: 56px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_pointer.png");
    -unity-background-scale-mode: scale-to-fit;
}

#tutorial-root #tutorial-skip,
#tutorial-root #tutorial-skip:hover,
#tutorial-root #tutorial-skip:focus,
#tutorial-root #tutorial-skip:active {
    width: 136px;
    height: 34px;
    margin: 0;
    padding: 4px 9px 5px 9px;
    background-color: transparent;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_hud_button_skip_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 0;
    border-radius: 0;
    color: rgb(25, 53, 70);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: normal;
}

#tutorial-root #tutorial-skip:hover,
#tutorial-root #tutorial-skip:focus {
    -unity-background-image-tint-color: rgb(239, 252, 249);
}

#tutorial-root #tutorial-skip:active {
    -unity-background-image-tint-color: rgb(209, 237, 232);
}

/* Завершение: отдельные PNG и нативные подписи в координатах эталона. */
#tutorial-complete-root {
    overflow: hidden;
    background-color: rgb(31, 61, 78);
    background-image: url("/Assets/Content/ui/sprites/modals/background_modal_new_york_full.png");
    -unity-background-scale-mode: scale-and-crop;
}

#tutorial-complete-root #tutorial-complete-design {
    position: absolute;
    width: 1672px;
    height: 941px;
    flex-shrink: 0;
    transform-origin: 0 0;
}

#tutorial-complete-root .unity-label {
    position: absolute;
    margin: 0;
    padding: 0;
    white-space: normal;
    color: rgb(25, 53, 70);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

#tutorial-complete-root #tutorial-complete-panel {
    position: absolute;
    left: 392px;
    top: 146px;
    width: 905px;
    height: 666px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_complete_panel.png");
    -unity-background-scale-mode: stretch-to-fill;
}

#tutorial-complete-root #tutorial-complete-title {
    left: 466px;
    top: 210px;
    width: 740px;
    height: 96px;
    font-size: 62px;
    color: rgb(255, 250, 231);
    -unity-text-outline-color: rgb(23, 32, 38);
    -unity-text-outline-width: 4px;
}

#tutorial-complete-root #tutorial-complete-emblem {
    position: absolute;
    left: 778px;
    top: 305px;
    width: 116px;
    height: 107px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_complete_emblem.png");
    -unity-background-scale-mode: scale-to-fit;
}

#tutorial-complete-root #tutorial-complete-message {
    left: 476px;
    top: 440px;
    width: 720px;
    height: 104px;
    font-size: 30px;
}

#tutorial-complete-root #tutorial-complete-divider {
    position: absolute;
    left: 514px;
    top: 548px;
    width: 645px;
    height: 17px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_complete_divider.png");
    -unity-background-scale-mode: stretch-to-fill;
}

#tutorial-complete-root #tutorial-complete-action,
#tutorial-complete-root #tutorial-complete-action:hover,
#tutorial-complete-root #tutorial-complete-action:focus,
#tutorial-complete-root #tutorial-complete-action:active {
    position: absolute;
    left: 634px;
    top: 604px;
    width: 405px;
    height: 125px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_complete_button_play_base.png");
    -unity-background-scale-mode: stretch-to-fill;
}

#tutorial-complete-root #tutorial-complete-action:hover,
#tutorial-complete-root #tutorial-complete-action:focus {
    -unity-background-image-tint-color: rgb(255, 240, 234);
}

#tutorial-complete-root #tutorial-complete-action:active {
    -unity-background-image-tint-color: rgb(229, 215, 210);
}

#tutorial-complete-root #tutorial-complete-action-label {
    left: 23px;
    top: 14px;
    width: 288px;
    height: 88px;
    font-size: 43px;
}

#tutorial-complete-root #tutorial-complete-play-icon {
    position: absolute;
    left: 318px;
    top: 32px;
    width: 43px;
    height: 52px;
    background-image: url("/Assets/Content/ui/sprites/tutorial/tutorial_complete_icon_play.png");
    -unity-background-scale-mode: scale-to-fit;
}

#tutorial-complete-root.tutorial-complete--error #tutorial-complete-emblem,
#tutorial-complete-root.tutorial-complete--error #tutorial-complete-play-icon {
    display: none;
}

#tutorial-complete-root.tutorial-complete--error #tutorial-complete-message {
    top: 348px;
    height: 168px;
}

#tutorial-complete-root.tutorial-complete--error #tutorial-complete-action-label {
    left: 26px;
    width: 353px;
}
