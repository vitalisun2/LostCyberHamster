.super-attacks-screen {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-top: 16px;
    padding-right: 28px;
    padding-bottom: 20px;
    padding-left: 28px;
}

.super-attacks__header {
    flex-grow: 0;
    flex-shrink: 0;
    height: 108px;
    flex-direction: row;
    align-items: center;
}

.super-attacks__back-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 280px;
    height: 82px;
    margin: 0;
    padding: 12px;
    font-size: 32px;
}

.super-attacks__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 58px;
    -unity-text-align: middle-center;
}

.super-attacks__header-balance {
    flex-grow: 0;
    flex-shrink: 0;
    width: 280px;
}

.super-attacks__progress-panel {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1180px;
    height: 270px;
    align-self: center;
    align-items: center;
    justify-content: center;
}

.super-attacks__level {
    height: 64px;
    font-size: 48px;
    -unity-text-align: middle-center;
}

.super-attacks__xp-row {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1040px;
    height: 132px;
    flex-direction: row;
    align-items: center;
}

.super-attacks__xp-progress {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 120px;
}

.super-attacks__xp-progress .unity-progress-bar__container {
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

.super-attacks__xp-progress .unity-progress-bar__background {
    flex-grow: 1;
    flex-shrink: 0;
    min-height: 0;
    width: 100%;
    height: 100%;
    align-self: stretch;
    position: relative;
    overflow: hidden;
    background-color: var(--ui-progress-track-original);
    border-color: var(--ui-border);
}

.super-attacks__xp-progress .unity-progress-bar__progress {
    min-height: 0;
    position: absolute;
    left: 0;
    top: 28px;
    bottom: 28px;
    background-color: var(--ui-border);
}

.super-attacks__xp-progress .unity-progress-bar__title {
    display: none;
}

.super-attacks__xp-label {
    flex-grow: 0;
    flex-shrink: 0;
    width: 250px;
    margin-left: 24px;
    font-size: 32px;
    -unity-text-align: middle-left;
}

.super-attacks__hint {
    height: 48px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.super-attacks__cards-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    margin-top: 8px;
}

.super-attacks__cards-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.super-attacks__cards {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.super-attacks__card {
    flex-grow: 0;
    flex-shrink: 0;
    width: 480px;
    min-height: 450px;
    margin-top: 8px;
    margin-right: 14px;
    margin-bottom: 16px;
    margin-left: 14px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    align-items: center;
    background-color: var(--ui-content-card-surface);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-color: var(--ui-border);
    border-top-left-radius: var(--ui-radius-main);
    border-top-right-radius: var(--ui-radius-main);
    border-bottom-right-radius: var(--ui-radius-main);
    border-bottom-left-radius: var(--ui-radius-main);
}

.super-attacks__card--active {
    background-color: var(--ui-status-warning-muted);
    border-top-color: var(--ui-border);
    border-right-color: var(--ui-border);
    border-bottom-color: var(--ui-border);
    border-left-color: var(--ui-border);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
}

.super-attacks__card--locked {
    opacity: 0.72;
}

.super-attacks__card-icon {
    flex-grow: 0;
    flex-shrink: 0;
    width: 154px;
    height: 154px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.super-attacks__card-lock {
    flex-grow: 0;
    flex-shrink: 0;
    height: 154px;
    font-size: 96px;
    color: var(--ui-content-card-text);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__card-name {
    width: 100%;
    min-height: 52px;
    color: var(--ui-content-card-text);
    font-size: 34px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__card-status {
    width: 100%;
    min-height: 44px;
    margin-top: 6px;
    color: var(--ui-content-card-accent);
    font-size: 28px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__card-status--active {
    color: var(--ui-status-success);
}

.super-attacks__card-requirement,
.super-attacks__card-threshold {
    width: 100%;
    min-height: 36px;
    color: var(--ui-content-card-text);
    font-size: 23px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__select-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 270px;
    height: 72px;
    margin-top: 14px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 8px;
    font-size: 28px;
    background-color: var(--ui-progress-fill-original);
    border-color: var(--ui-content-card-accent);
    color: var(--ui-progress-track-original);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ui-content-card-accent);
}

.super-attacks__select-button:hover {
    background-color: var(--ui-control-hover-original);
    border-color: var(--ui-content-card-accent);
}

.super-attacks__select-button:active:hover:focus,
.super-attacks__select-button:active:focus,
.super-attacks__select-button:active {
    background-color: var(--ui-control-hover-original);
    border-color: var(--ui-content-card-accent);
}

.super-attacks__select-button:focus {
    border-color: var(--ui-content-card-accent);
}
