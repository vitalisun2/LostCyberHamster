.return-screen { flex-grow: 1; padding: 16px 26px; }
.return-header { flex-direction: row; align-items: center; margin-bottom: 12px; }
.return-title { flex-grow: 1; font-size: 30px; color: white; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 2px; -unity-text-outline-color: black; }
.return-scroll { flex-grow: 1; min-height: 0; }
.return-balances { flex-direction: row; justify-content: center; height: 58px; margin-bottom: 6px; }
.return-columns { flex-direction: row; align-items: stretch; }
.return-panel { flex-grow: 1; flex-shrink: 1; width: 0; min-width: 0; padding: 22px; margin: 5px; background-image: url("/Assets/Content/ui/sprites/shared/panel_reward_base.png"); -unity-background-scale-mode: stretch-to-fill; -unity-slice-left: 60px; -unity-slice-right: 60px; -unity-slice-top: 60px; -unity-slice-bottom: 60px; }
.return-panel--selected { border-left-width: 4px; border-left-color: rgb(239, 176, 40); }
.return-heading { font-size: 23px; -unity-font-style: bold; white-space: normal; color: rgb(29, 41, 47); margin-bottom: 10px; }
.return-text { font-size: 17px; white-space: normal; color: rgb(29, 41, 47); margin-bottom: 8px; }
.return-days { flex-direction: row; margin-bottom: 8px; }
.return-day { flex-grow: 1; flex-shrink: 1; width: 0; min-width: 0; min-height: 88px; font-size: 16px; white-space: normal; -unity-text-align: middle-center; color: rgb(29, 41, 47); background-color: rgb(218, 225, 224); border-radius: 12px; margin: 3px; padding: 6px; }
.return-day--earned { background-color: rgb(190, 223, 180); }
.return-day--final { border-width: 3px; border-color: rgb(225, 167, 40); }
.return-button { min-height: 48px; padding: 8px 20px; font-size: 18px; white-space: normal; color: rgb(25, 35, 42); background-color: rgb(241, 234, 211); border-radius: 12px; border-width: 2px; border-color: rgb(30, 41, 45); }
.return-button--primary { background-color: rgb(255, 199, 55); -unity-font-style: bold; }
.return-button:disabled { opacity: 0.55; }
.return-pending { margin-top: 12px; }
.return-week-progress { margin-top: 12px; }
.return-footer { font-size: 16px; white-space: normal; -unity-text-align: middle-center; color: white; -unity-text-outline-width: 1px; -unity-text-outline-color: black; margin-top: 8px; }
.return-recover { margin: 10px; }
