.shared-hud-lane {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 76px;
    min-height: 76px;
    max-height: 76px;
    margin-top: 10px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-bottom: 0;
    flex-direction: row;
    align-items: center;
}

.shared-hud-control {
    flex-grow: 0;
    flex-shrink: 0;
    height: 76px;
    min-height: 76px;
    max-height: 76px;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    overflow: visible;
    transition-property: opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.shared-hud-control:hover,
.shared-hud-control:focus {
    opacity: 0.94;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.shared-hud-control:active {
    opacity: 0.84;
    background-color: rgba(0, 0, 0, 0);
}

.shared-home-button {
    width: 84px;
    min-width: 84px;
    max-width: 84px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_home.png");
    -unity-background-scale-mode: scale-to-fit;
}

.shared-settings-button {
    width: 78px;
    min-width: 78px;
    max-width: 78px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_settings.png");
    -unity-background-scale-mode: scale-to-fit;
}

.shared-currency-button {
    width: 205px;
    min-width: 205px;
    max-width: 205px;
}

.shared-currency-button__plate {
    position: absolute;
    left: 44px;
    top: 8px;
    width: 161px;
    height: 60px;
    padding-right: 14px;
    padding-left: 34px;
    justify-content: center;
    background-image: url("/Assets/Content/ui/sprites/shared/hud_currency_plate.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 24px;
    -unity-slice-right: 24px;
    -unity-slice-top: 14px;
    -unity-slice-bottom: 14px;
}

.shared-currency-button__label {
    width: 100%;
    height: 60px;
    color: rgb(255, 255, 255);
    font-size: 38px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 2px;
}

.shared-currency-button__label--compact {
    font-size: 30px;
}

.shared-currency-button__icon {
    position: absolute;
    left: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.shared-currency-button__icon--coins {
    top: 2px;
    width: 74px;
    height: 71px;
    background-image: url("/Assets/Content/ui/sprites/shared/hud_coins_icon_plus.png");
}

.shared-currency-button__icon--gems {
    top: 1px;
    width: 79px;
    height: 73px;
    background-image: url("/Assets/Content/ui/sprites/shared/hud_gems_icon_plus.png");
}
