.modal--account-prompt #modal__container {
    overflow: visible;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 0;
}

.modal--account-prompt #modal__content {
    width: 100%;
    height: 100%;
    margin: 0;
}

.modal--account-prompt #btn_close-modal {
    display: none;
}

.account-prompt {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1100px;
    height: 580px;
    padding-top: 118px;
    padding-right: 90px;
    padding-bottom: 58px;
    padding-left: 90px;
    align-self: center;
    align-items: center;
    justify-content: flex-start;
    overflow: visible;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/settings/panel_name_edit_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 44;
    -unity-slice-bottom: 44;
}

.account-prompt__title {
    position: absolute;
    left: 190px;
    top: -24px;
    width: 720px;
    height: 82px;
    margin: 0;
    padding: 0 28px;
    color: rgb(255, 255, 255);
    font-size: 42px;
    white-space: normal;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/settings/button_primary_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.account-prompt__body-panel {
    flex-grow: 0;
    width: 860px;
    min-height: 168px;
    padding-top: 25px;
    padding-right: 38px;
    padding-bottom: 25px;
    padding-left: 38px;
    align-items: center;
    justify-content: center;
    background-color: rgb(41, 99, 130);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-color: rgb(15, 35, 45);
    border-radius: 18px;
}

.account-prompt__body {
    width: 100%;
    min-height: 110px;
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 30px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.account-prompt__actions {
    flex-grow: 0;
    width: 780px;
    height: 86px;
    margin-top: 48px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.account-prompt__button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 360px;
    height: 82px;
    min-width: 360px;
    min-height: 82px;
    margin: 0;
    padding: 0 24px;
    color: rgb(255, 255, 255);
    font-size: 30px;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 0;
    transition-property: scale, opacity;
    transition-duration: 90ms;
    transition-timing-function: ease-out;
}

.account-prompt__button--primary {
    background-image: url("/Assets/Content/ui/sprites/settings/button_primary_base.png");
}

.account-prompt__button--secondary {
    background-image: url("/Assets/Content/ui/sprites/settings/button_secondary_base.png");
}

.account-prompt__button:hover,
.account-prompt__button:focus {
    opacity: 0.96;
    scale: 1.025 1.025;
    background-color: rgba(0, 0, 0, 0);
}

.account-prompt__button:active {
    opacity: 0.88;
    scale: 0.975 0.975;
    background-color: rgba(0, 0, 0, 0);
}

.account-prompt__button:disabled {
    opacity: 0.55;
}

.account-prompt-later-message {
    display: none;
    position: absolute;
    left: 128px;
    right: 128px;
    bottom: 32px;
    min-height: 72px;
    padding: 16px 28px;
    background-color: rgb(41, 99, 130);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-color: rgb(15, 35, 45);
    border-radius: 16px;
    color: rgb(255, 255, 255);
    font-size: 25px;
    white-space: normal;
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
