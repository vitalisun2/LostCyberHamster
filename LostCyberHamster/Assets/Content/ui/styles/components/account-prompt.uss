.account-prompt-later-message {
    position: absolute;
    left: 128px;
    right: 128px;
    bottom: 32px;
    padding: 16px;
    background-color: var(--ui-overlay-panel);
    border-radius: var(--ui-radius-secondary);
    border-width: 4px;
    border-color: var(--ui-border);
    color: var(--ui-text-fill);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: 28px;
    white-space: normal;
}
