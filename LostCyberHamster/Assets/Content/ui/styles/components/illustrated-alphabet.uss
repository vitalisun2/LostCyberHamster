.illustrated-alphabet {
    overflow: visible;
    justify-content: center;
    align-items: center;
}

.illustrated-alphabet__word {
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 100px;
    transform-origin: 50% 50%;
}

.illustrated-alphabet__glyph,
.illustrated-alphabet__space {
    flex-grow: 0;
    flex-shrink: 0;
    height: 100px;
}

.illustrated-alphabet__glyph {
    margin-left: 0;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.illustrated-alphabet__fallback {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    color: white;
    -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: black;
}

