#energybar {
    flex-grow: 0;
    flex-shrink: 0;
    width: 400px;
    height: 100px;
    overflow: visible;
}

#energybar > .energy-bar__track,
#energybar > .energy-bar__fill-clip,
#energybar > .energy-bar__frame {
    position: absolute;
    left: 0;
    top: 23px;
    width: 400px;
    height: 54px;
}

#energybar > .energy-bar__track {
    background-image: url("/Assets/Content/ui/sprites/in_game_hud/hud_bar_energy_track.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

#energybar > .energy-bar__fill-clip {
    overflow: hidden;
}

#energybar .energy-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 54px;
    background-image: url("/Assets/Content/ui/sprites/shared/progress_fill_blue.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

#energybar > .energy-bar__frame {
    background-image: url("/Assets/Content/ui/sprites/in_game_hud/hud_bar_energy_frame.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 18;
    -unity-slice-bottom: 18;
}

#energybar > .energy-bar__icon-underlay {
    position: absolute;
    left: 10px;
    top: 21px;
    width: 58px;
    height: 58px;
    background-image: url("/Assets/Content/ui/sprites/in_game_hud/hud_underlay_energy_icon.png");
    -unity-background-scale-mode: scale-to-fit;
}

#energybar > .energy-bar__icon {
    position: absolute;
    left: 14px;
    top: 15px;
    width: 50px;
    height: 70px;
    background-image: url("/Assets/Content/ui/sprites/in_game_hud/hud_icon_energy_battery.png");
    -unity-background-scale-mode: scale-to-fit;
}

#energybar > .energy-bar__value {
    position: absolute;
    left: 92px;
    top: 23px;
    width: 266px;
    height: 54px;
    color: rgb(245, 251, 255);
    font-size: 27px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(11, 25, 33);
}

#healthbar {
    height: 30px;
    width: 200px;
}
