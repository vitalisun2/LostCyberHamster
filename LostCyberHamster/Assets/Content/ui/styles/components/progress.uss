.unity-progress-bar__background {
    background-color: var(--ui-text-fill);
    border-width: 6px;
    border-color: var(--ui-border);
    min-height: 76px;
    border-radius: var(--ui-radius-main);
}

.unity-progress-bar__progress {
    background-color: var(--ui-surface);
    margin: 0;
    min-height: 40px;
    border-radius: var(--ui-radius-secondary);
}

.unity-progress-bar__title {
    color: var(--ui-text-fill);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ui-text-outline);
    -unity-font-style: bold;
    font-size: var(--ui-font-size);
}

.shared-progress-bar {
    margin: 0;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/shared/progress_bar_empty.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 14px;
    -unity-slice-right: 14px;
    -unity-slice-top: 12px;
    -unity-slice-bottom: 12px;
}

.shared-progress-bar .unity-progress-bar__background {
    min-height: 0;
    padding-top: 3px;
    padding-right: 3px;
    padding-bottom: 3px;
    padding-left: 3px;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.shared-progress-bar .unity-progress-bar__progress {
    min-height: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("/Assets/Content/ui/sprites/shared/progress_bar_fill.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 14px;
    -unity-slice-right: 14px;
    -unity-slice-top: 12px;
    -unity-slice-bottom: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}
