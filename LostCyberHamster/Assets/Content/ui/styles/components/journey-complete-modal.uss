.journey-complete-modal {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.journey-complete-modal__viewport {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.journey-complete-modal__scale-frame {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1724px;
    height: 912px;
}

.journey-complete-modal__design {
    position: absolute;
    left: 0;
    top: 0;
    width: 1724px;
    height: 912px;
    transform-origin: 0 0;
}

.journey-complete-modal__art {
    position: absolute;
    left: 112px;
    top: 46px;
    width: 1521px;
    height: 838px;
    background-image: url("/Assets/Content/ui/sprites/journey_complete/modal_journey_complete.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.journey-complete-modal__text {
    position: absolute;
    margin: 0;
    padding: 0;
    color: rgb(69, 43, 28);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: normal;
}

.journey-complete-modal__message-primary {
    left: 365px;
    top: 184px;
    width: 995px;
    height: 78px;
    font-size: 30px;
}

.journey-complete-modal__message-secondary {
    left: 395px;
    top: 269px;
    width: 935px;
    height: 35px;
    font-size: 20px;
    -unity-font-style: normal;
}

.journey-complete-modal__goal {
    height: 86px;
    font-size: 27px;
}

.journey-complete-modal__goal--level-up {
    left: 181px;
    top: 444px;
    width: 474px;
}

.journey-complete-modal__goal--unlock {
    left: 1062px;
    top: 516px;
    width: 502px;
}

.journey-complete-modal__goal--rankings {
    left: 178px;
    top: 645px;
    width: 504px;
}

.journey-complete-modal__button {
    position: absolute;
    margin: 0;
    padding: 0;
    color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    overflow: visible;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: scale, opacity;
    transition-duration: 80ms;
    transition-timing-function: ease-out;
}

.journey-complete-modal__button:hover,
.journey-complete-modal__button:focus {
    opacity: 0.96;
    scale: 1.04 1.04;
}

.journey-complete-modal__button:active {
    opacity: 0.9;
    scale: 0.96 0.96;
}

.journey-complete-modal__button--home {
    left: 1070px;
    top: 784px;
    width: 79px;
    height: 72px;
    background-image: url("/Assets/Content/ui/sprites/shared/button_home.png");
}

.journey-complete-modal__button--skills {
    left: 1178px;
    top: 791px;
    width: 81px;
    height: 63px;
    background-image: url("/Assets/Content/ui/sprites/journey_complete/button_skills.png");
}

.journey-complete-modal__button--rankings {
    left: 1292px;
    top: 794px;
    width: 74px;
    height: 64px;
    background-image: url("/Assets/Content/ui/sprites/journey_complete/button_rankings.png");
}
