#next-goal-card {
    position: absolute;
    transform-origin: 0 0;
    flex-shrink: 0;
    background-image: url("/Assets/Content/ui/sprites/shared/panel_reward_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 80;
    -unity-slice-bottom: 80;
    -unity-slice-scale: 0.5;
}

#next-goal-card .next-goal-card__header {
    position: absolute;
    left: 38px;
    right: 96px;
    top: 5px;
    height: 54px;
    background-image: url("/Assets/Content/ui/sprites/shared/next_goal/goal_header.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 200;
    -unity-slice-right: 200;
    -unity-slice-top: 220;
    -unity-slice-bottom: 240;
    -unity-slice-scale: 0.07;
}

#next-goal-card .next-goal-card__icon {
    position: absolute;
    left: 8px;
    top: -10px;
    width: 76px;
    height: 78px;
    -unity-background-scale-mode: scale-to-fit;
}

#next-goal-card .next-goal-card__heading,
#next-goal-card .next-goal-card__text,
#next-goal-card .next-goal-card__detail {
    position: absolute;
    margin: 0;
    padding: 0;
    color: rgb(16, 32, 53);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    white-space: normal;
    overflow: hidden;
}

#next-goal-card .next-goal-card__heading {
    left: 40px;
    right: 10px;
    top: 5px;
    height: 40px;
    font-size: 20px;
}

#next-goal-card .next-goal-card__text {
    left: 22px;
    right: 22px;
    top: 70px;
    height: 108px;
    font-size: 25px;
}

#next-goal-card .next-goal-card__detail {
    left: 25px;
    right: 25px;
    top: 203px;
    height: 50px;
    font-size: 18px;
}

#next-goal-card .next-goal-card__progress {
    position: absolute;
    left: 30px;
    right: 30px;
    top: 181px;
    height: 20px;
    padding: 3px;
    background-image: url("/Assets/Content/ui/sprites/shared/progress_bar_empty.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 0.5;
}

#next-goal-card .next-goal-card__progress-fill {
    height: 100%;
    background-image: url("/Assets/Content/ui/sprites/shared/progress_bar_fill.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 12;
    -unity-slice-bottom: 12;
    -unity-slice-scale: 0.5;
}

#next-goal-card .next-goal-card__action,
#next-goal-card .next-goal-card__dismiss {
    position: absolute;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    transition-property: opacity;
    transition-duration: 90ms;
}

#next-goal-card .next-goal-card__action {
    left: 22px;
    right: 22px;
    top: 257px;
    height: 60px;
    padding: 4px 14px 10px;
    background-image: url("/Assets/Content/ui/sprites/hero/button_select_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.7;
    color: white;
    font-size: 22px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(13, 32, 48);
}

#next-goal-card .next-goal-card__dismiss {
    right: 5px;
    top: -14px;
    width: 80px;
    height: 84px;
    padding: 0;
    background-image: url("/Assets/Content/ui/sprites/hero/button_select_base.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 24;
    -unity-slice-bottom: 24;
    -unity-slice-scale: 0.6;
    font-size: 64px;
    color: white;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(13, 32, 48);
}

#next-goal-card .next-goal-card__action:hover,
#next-goal-card .next-goal-card__dismiss:hover { opacity: 0.85; }
#next-goal-card .next-goal-card__action:active,
#next-goal-card .next-goal-card__dismiss:active { opacity: 0.65; }


#next-goal-card.next-goal-card--home { background-image: url("/Assets/Content/ui/sprites/shared/retention/panel_parchment.png"); -unity-slice-left: 120; -unity-slice-right: 120; -unity-slice-top: 110; -unity-slice-bottom: 110; -unity-slice-scale: 0.4; }
#next-goal-card.next-goal-card--home .next-goal-card__header { left: 46px; right: 90px; top: 26px; height: 45px; }
#next-goal-card.next-goal-card--home .next-goal-card__heading { left: 48px; right: 6px; top: 2px; height: 40px; font-size: 24px; }
#next-goal-card.next-goal-card--home .next-goal-card__icon { left: 24px; top: 20px; width: 76px; height: 76px; }
#next-goal-card.next-goal-card--home .next-goal-card__text { left: 30px; right: 30px; top: 99px; height: 76px; font-size: 30px; }
#next-goal-card.next-goal-card--home .next-goal-card__detail { left: 26px; right: 26px; top: 173px; height: 45px; font-size: 24px; }
#next-goal-card.next-goal-card--home.next-goal-card--progress .next-goal-card__text { top: 88px; height: 74px; }
#next-goal-card.next-goal-card--home.next-goal-card--progress .next-goal-card__detail { top: 181px; height: 43px; }
#next-goal-card.next-goal-card--home .next-goal-card__progress { left: 50px; right: 50px; top: 165px; height: 16px; }
#next-goal-card.next-goal-card--home .next-goal-card__action { left: 80px; right: 80px; top: 229px; height: 65px; font-size: 27px; }
#next-goal-card.next-goal-card--home .next-goal-card__dismiss { top: 21px; right: 24px; width: 61px; height: 64px; font-size: 52px; }

#next-goal-card.next-goal-card--home .next-goal-card__action { -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf"); -unity-font-style: bold; -unity-text-outline-width: 1px; }
