#shop-item {
    margin: 24px;
    background-color: var(--ui-surface);
    border-radius: 12px;
    border-width: 6px;
    border-color: var(--ui-border);
    height: 360px;
    width: 300px;
    margin-bottom: 24px;
}

.shop-item__btn-get {
    background-color: var(--ui-status-danger);
    border-radius: 12px;
    border-width: 6px;
    border-color: var(--ui-border);
    height: 64px;
    font-size: var(--ui-font-size-small);
    margin-bottom: 24px;
    color: var(--ui-text-fill);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: var(--ui-text-outline);
    -unity-font-style: bold;
}
