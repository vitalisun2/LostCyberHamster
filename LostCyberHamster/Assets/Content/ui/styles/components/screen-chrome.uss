#toolbar {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

/*
 * Shared layout contract for the persistent chrome of main menu screens.
 * HUD and title use root coordinates and never inherit a screen content
 * design-frame scale. Screen-specific layouts remain inside main-screen-body.
 */
.main-screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.main-screen-body {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
}

.main-screen-body--below-hud {
    top: 86px;
}

.main-screen-title {
    position: absolute;
    left: 50%;
    top: 88px;
    height: 88px;
    translate: -50% 0;
    -unity-background-scale-mode: scale-to-fit;
}

.main-screen-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    width: auto;
    height: 86px;
    min-height: 86px;
    max-height: 86px;
}

.shared-hud-lane.main-screen-hud {
    height: 76px;
    min-height: 76px;
    max-height: 76px;
}

.shared-toolbar {
    padding-right: 20px;
    padding-left: 20px;
}

.shared-toolbar__left,
.shared-toolbar__right {
    height: 76px;
    flex-direction: row;
    align-items: center;
}

.shared-toolbar__left {
    gap: 12px;
}

.shared-toolbar__spacer {
    flex-grow: 1;
    min-width: 0;
}

.shared-toolbar__back {
    display: none;
    flex-grow: 0;
    flex-shrink: 0;
    width: 200px;
    height: 76px;
    margin: 0;
}
