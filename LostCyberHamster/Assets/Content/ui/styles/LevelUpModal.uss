.level-up-modal {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    padding: 20px 48px;
}

.level-up-modal__title {
    min-height: 58px;
    color: var(--ui-text-fill);
    -unity-text-outline-color: var(--ui-text-outline);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-modal__transition {
    min-height: 52px;
    margin-top: 2px;
    color: var(--ui-text-fill);
    -unity-text-outline-color: var(--ui-text-outline);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-modal__attack-card {
    width: 440px;
    min-height: 270px;
    margin-top: 10px;
    padding: 16px 24px;
    align-items: center;
    justify-content: center;
    background-color: var(--ui-surface);
    border-color: var(--ui-border);
    border-width: 6px;
    border-radius: 20px;
}

.level-up-modal__attack-icon {
    width: 124px;
    height: 124px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.level-up-modal__attack-name {
    min-height: 48px;
    margin-top: 4px;
    color: var(--ui-text-fill);
    -unity-text-outline-color: var(--ui-text-outline);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.level-up-modal__attack-status {
    min-height: 40px;
    margin-top: 2px;
    color: var(--ui-compact-text);
    -unity-text-outline-width: 0;
    font-size: 25px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-modal__ok {
    width: 220px;
    height: 72px;
    margin-top: 14px;
    font-size: 30px;
    color: var(--ui-compact-text);
    -unity-text-outline-width: 0;
}
