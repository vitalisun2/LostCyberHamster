.level-up-modal {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    align-items: center;
    justify-content: center;
    padding: 20px 48px;
}

.level-up-modal__title {
    min-height: 58px;
    color: var(--ui-text-fill);
    -unity-text-outline-color: var(--ui-text-outline);
    font-size: 48px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-modal__transition {
    min-height: 52px;
    margin-top: 2px;
    color: var(--ui-text-fill);
    -unity-text-outline-color: var(--ui-text-outline);
    font-size: 36px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.level-up-modal__development-reward {
    width: 620px;
    min-height: 150px;
    margin-top: 18px;
    color: var(--ui-text-fill);
    -unity-text-outline-color: var(--ui-text-outline);
    font-size: 38px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.level-up-modal__ok {
    width: 220px;
    height: 72px;
    margin-top: 14px;
    font-size: 30px;
    color: var(--ui-compact-text);
    -unity-text-outline-width: 0;
}
