:root {
    -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf");
}

:root .unity-text-element {
    -unity-font-definition: url("/Assets/Content/ui/fonts/Nunito-Bold.ttf");
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
