.super-attacks-screen {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding-top: 16px;
    padding-right: 28px;
    padding-bottom: 20px;
    padding-left: 28px;
}

.super-attacks__header {
    flex-grow: 0;
    flex-shrink: 0;
    height: 108px;
    flex-direction: row;
    align-items: center;
}

.super-attacks__back-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 280px;
    height: 82px;
    margin: 0;
    padding: 12px;
    font-size: 32px;
}

.super-attacks__title {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    font-size: 58px;
    -unity-text-align: middle-center;
}

.super-attacks__header-balance {
    flex-grow: 0;
    flex-shrink: 0;
    width: 280px;
}

.super-attacks__progress-panel {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1180px;
    height: 212px;
    align-self: center;
    align-items: center;
    justify-content: center;
}

.super-attacks__level {
    height: 64px;
    font-size: 48px;
    -unity-text-align: middle-center;
}

.super-attacks__xp-row {
    flex-grow: 0;
    flex-shrink: 0;
    width: 1040px;
    height: 78px;
    flex-direction: row;
    align-items: center;
}

.super-attacks__xp-progress {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 66px;
}

.super-attacks__xp-progress .unity-progress-bar__background {
    min-height: 0;
    height: 66px;
}

.super-attacks__xp-progress .unity-progress-bar__progress {
    min-height: 0;
    height: 52px;
}

.super-attacks__xp-progress .unity-progress-bar__title {
    display: none;
}

.super-attacks__xp-label {
    flex-grow: 0;
    flex-shrink: 0;
    width: 250px;
    margin-left: 24px;
    font-size: 32px;
    -unity-text-align: middle-left;
}

.super-attacks__hint {
    height: 48px;
    font-size: 28px;
    -unity-text-align: middle-center;
}

.super-attacks__cards-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    width: 100%;
    margin-top: 8px;
}

.super-attacks__cards-scroll .unity-scroll-view__content-container {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.super-attacks__cards {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
}

.super-attacks__card {
    flex-grow: 0;
    flex-shrink: 0;
    width: 480px;
    min-height: 450px;
    margin-top: 8px;
    margin-right: 14px;
    margin-bottom: 16px;
    margin-left: 14px;
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    align-items: center;
    background-color: rgba(242, 233, 196, 0.96);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-color: var(--secondary);
    border-right-color: var(--secondary);
    border-bottom-color: var(--secondary);
    border-left-color: var(--secondary);
    border-top-left-radius: var(--main-border-radius);
    border-top-right-radius: var(--main-border-radius);
    border-bottom-right-radius: var(--main-border-radius);
    border-bottom-left-radius: var(--main-border-radius);
}

.super-attacks__card--active {
    background-color: rgba(156, 204, 48, 0.28);
    border-top-color: var(--warning);
    border-right-color: var(--warning);
    border-bottom-color: var(--warning);
    border-left-color: var(--warning);
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
}

.super-attacks__card--locked {
    opacity: 0.72;
}

.super-attacks__card-icon {
    flex-grow: 0;
    flex-shrink: 0;
    width: 154px;
    height: 154px;
    margin-bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.super-attacks__card-lock {
    flex-grow: 0;
    flex-shrink: 0;
    height: 154px;
    font-size: 96px;
    color: rgb(50, 43, 34);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__card-name {
    width: 100%;
    min-height: 52px;
    color: rgb(50, 43, 34);
    font-size: 34px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__card-status {
    width: 100%;
    min-height: 44px;
    margin-top: 6px;
    color: var(--secondary);
    font-size: 28px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__card-status--active {
    color: rgb(74, 126, 24);
}

.super-attacks__card-requirement,
.super-attacks__card-threshold {
    width: 100%;
    min-height: 36px;
    color: rgb(50, 43, 34);
    font-size: 23px;
    white-space: normal;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.super-attacks__select-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 270px;
    height: 72px;
    margin-top: 14px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding: 8px;
    font-size: 28px;
}

.home-hud {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
    height: 112px;
    padding-top: 10px;
    padding-right: 18px;
    padding-bottom: 10px;
    padding-left: 18px;
    flex-direction: row;
    align-items: center;
}

.home-hud__side {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    min-width: 0;
    height: 100%;
    flex-direction: row;
    align-items: center;
}

.home-hud__left {
    justify-content: flex-start;
}

.home-hud__right {
    justify-content: flex-end;
}

.home-hud__character-button,
.home-hud__settings-button {
    flex-grow: 0;
    flex-shrink: 0;
    width: 104px;
    height: 82px;
    margin: 0;
    padding: 8px;
    font-size: 28px;
}

.home-hud .storage-container {
    flex-grow: 0;
    flex-shrink: 1;
    width: 220px;
    min-width: 160px;
    height: 70px;
    margin-left: 12px;
}

.home-hud .storage-image {
    flex-grow: 0;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
}

.home-hud .storage-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 6px;
    font-size: 28px;
}

.home-hud #storage__btn-add {
    display: none;
}

.home-super-attacks-xp-panel {
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
    width: 620px;
    height: 82px;
    padding-top: 10px;
    padding-right: 14px;
    padding-bottom: 10px;
    padding-left: 14px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(242, 233, 196, 0.96);
    border-top-width: 6px;
    border-right-width: 6px;
    border-bottom-width: 6px;
    border-left-width: 6px;
    border-top-color: var(--secondary);
    border-right-color: var(--secondary);
    border-bottom-color: var(--secondary);
    border-left-color: var(--secondary);
    border-top-left-radius: var(--main-border-radius);
    border-top-right-radius: var(--main-border-radius);
    border-bottom-right-radius: var(--main-border-radius);
    border-bottom-left-radius: var(--main-border-radius);
}

.home-super-attacks-xp-panel__level {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100px;
    height: 52px;
    color: rgb(50, 43, 34);
    font-size: 26px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.home-super-attacks-xp-panel__progress {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    min-width: 0;
    height: 48px;
    margin-right: 12px;
    margin-left: 12px;
}

.home-super-attacks-xp-panel__progress .unity-progress-bar__background {
    min-height: 0;
    height: 48px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
}

.home-super-attacks-xp-panel__progress .unity-progress-bar__progress {
    min-height: 0;
    height: 36px;
}

.home-super-attacks-xp-panel__progress .unity-progress-bar__title {
    color: rgb(50, 43, 34);
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}

.home-super-attacks-xp-panel__xp {
    flex-grow: 0;
    flex-shrink: 0;
    width: 132px;
    color: rgb(50, 43, 34);
    font-size: 24px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
}
