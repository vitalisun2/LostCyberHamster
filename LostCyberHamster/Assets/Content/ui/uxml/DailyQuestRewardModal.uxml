<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/DailyQuestRewardModal.uss" />
    <engine:VisualElement class="daily-quest-reward-modal">
        <engine:Label name="daily-quest-reward-title" class="lcs-text daily-quest-reward-modal__title" />
        <engine:Button name="btn_daily_quest_reward_claim" class="lcs_btn daily-quest-reward-modal__claim">
            <engine:Label name="daily-quest-reward-claim-label" class="daily-quest-reward-modal__claim-label" />
            <engine:Label name="daily-quest-reward-amount" class="daily-quest-reward-modal__amount" />
            <engine:VisualElement name="daily-quest-reward-image" class="daily-quest-reward-modal__image" />
        </engine:Button>
    </engine:VisualElement>
</engine:UXML>
