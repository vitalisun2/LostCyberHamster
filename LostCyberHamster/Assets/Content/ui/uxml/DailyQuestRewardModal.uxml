<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/components/reward-modals.uss" />
    <Style src="../styles/DailyQuestRewardModal.uss" />
    <engine:VisualElement class="reward-modal daily-quest-reward-modal">
        <engine:VisualElement name="reward-modal-viewport" class="reward-modal__viewport" picking-mode="Ignore">
            <engine:VisualElement name="reward-modal-frame" class="reward-modal__frame" picking-mode="Ignore">
                <engine:VisualElement name="reward-modal-design" class="reward-modal__design" picking-mode="Ignore">
                    <engine:VisualElement class="reward-modal__panel" picking-mode="Ignore" />
                    <engine:Label name="daily-quest-reward-title" class="reward-modal__text reward-modal__title daily-quest-reward-modal__title" picking-mode="Ignore" />
                    <engine:VisualElement class="daily-quest-reward-modal__emblem" picking-mode="Ignore" />
                    <engine:VisualElement class="daily-quest-reward-modal__reward-row" picking-mode="Ignore">
                        <engine:Label name="daily-quest-reward-caption" class="reward-modal__text daily-quest-reward-modal__caption" picking-mode="Ignore" />
                        <engine:Label name="daily-quest-reward-amount" class="reward-modal__text daily-quest-reward-modal__amount" picking-mode="Ignore" />
                        <engine:VisualElement name="daily-quest-reward-image" class="daily-quest-reward-modal__image" picking-mode="Ignore" />
                    </engine:VisualElement>
                    <engine:Button name="btn_daily_quest_reward_claim" class="reward-modal__primary">
                        <engine:Label name="daily-quest-reward-claim-label" class="reward-modal__text daily-quest-reward-modal__claim-label" picking-mode="Ignore" />
                    </engine:Button>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
