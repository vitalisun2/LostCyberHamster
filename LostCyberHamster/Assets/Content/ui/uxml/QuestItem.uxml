<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="quest-item" style="width: 100%; height: 100%; min-width: 0; min-height: 0; flex-grow: 1; flex-shrink: 1; align-items: center; justify-content: center; background-color: rgb(255, 247, 228); padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px;">
        <engine:VisualElement name="quest-item__frame" style="width: 100%; height: 100%; flex-grow: 0; align-items: center; background-color: rgb(255, 247, 228); border-left-width: 8px; border-right-width: 8px; border-top-width: 8px; border-bottom-width: 8px; border-left-color: rgb(43, 61, 66); border-right-color: rgb(43, 61, 66); border-top-color: rgb(43, 61, 66); border-bottom-color: rgb(43, 61, 66); border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-right-radius: 22px; border-bottom-left-radius: 22px; padding-top: 18px; padding-right: 18px; padding-bottom: 18px; padding-left: 18px;">
            <engine:VisualElement name="quest-item__image-circle" style="width: 180px; height: 180px; flex-grow: 0; flex-shrink: 0; align-items: center; justify-content: center; overflow: hidden; background-color: rgb(217, 211, 225); border-top-left-radius: 90px; border-top-right-radius: 90px; border-bottom-right-radius: 90px; border-bottom-left-radius: 90px;">
                <engine:VisualElement name="quest-item__image" style="width: 142px; height: 142px; flex-grow: 0; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit;" />
            </engine:VisualElement>
            <engine:Label text="Quest title" name="quest-item__title" class="lcs-text" style="width: 100%; height: 92px; flex-grow: 0; flex-shrink: 0; margin-top: 14px; color: rgb(38, 54, 59); font-size: 24px; white-space: normal; -unity-font-style: bold; -unity-text-align: middle-center; -unity-text-outline-width: 0px;" />
            <engine:Label text="0 / 0" name="quest-item__progress" class="lcs-text" style="flex-grow: 0; flex-shrink: 0; margin-bottom: 12px; color: rgb(54, 73, 78); font-size: 22px; -unity-text-align: middle-center; -unity-text-outline-width: 0px;" />
            <engine:VisualElement style="flex-grow: 1;" />
            <engine:VisualElement name="quest-item__reward-action" style="width: 270px; height: 70px; flex-grow: 0; flex-shrink: 0; margin-bottom: 16px;">
                <Vues.GameCore.LocalizedButton key="btn_get" name="quest-item__reward-get" class="lcs_btn" style="position: absolute; left: 0; top: 0; width: 100%; height: 100%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-left: 28px; padding-right: 112px; background-color: rgb(221, 142, 47); border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px; border-left-color: rgb(43, 61, 66); border-right-color: rgb(43, 61, 66); border-top-color: rgb(43, 61, 66); border-bottom-color: rgb(43, 61, 66); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; color: rgb(255, 255, 255); opacity: 1; font-size: 26px; -unity-font-style: bold; -unity-text-align: middle-left; -unity-text-outline-width: 0px;" />
                <engine:VisualElement picking-mode="Ignore" style="position: absolute; right: 18px; top: 0; height: 100%; flex-direction: row; align-items: center; justify-content: flex-end;">
                    <engine:Label text="10" name="quest-item__reward-amount" style="margin-right: 8px; color: rgb(255, 255, 255); font-size: 28px; -unity-font-style: bold; -unity-text-align: middle-center;" />
                    <engine:VisualElement name="quest-item__reward-image" style="width: 40px; height: 40px; flex-grow: 0; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit;" />
                </engine:VisualElement>
            </engine:VisualElement>
            <engine:VisualElement name="quest-item__reward-claimed" style="display: none; width: 270px; height: 70px; flex-grow: 0; flex-shrink: 0; margin-bottom: 16px; flex-direction: row; align-items: center; justify-content: center;">
                <engine:Label text="✓" style="margin-right: 10px; color: rgb(67, 173, 91); font-size: 38px; -unity-font-style: bold;" />
                <Vues.GameCore.LocalizedLabel key="quest_reward_claimed" class="lcs-text" style="color: rgb(38, 54, 59); font-size: 20px; white-space: normal; -unity-font-style: bold; -unity-text-align: middle-left; -unity-text-outline-width: 0px;" />
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
