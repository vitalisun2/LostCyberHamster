<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="settingsscreen" class="settings-screen">
        <engine:VisualElement name="settings-viewport" class="settings-viewport">
            <engine:VisualElement name="settings-scale-frame" class="settings-scale-frame">
                <engine:VisualElement name="settings-design" class="settings-design">
                    <LostCyberHamster.UI.SharedHudLane class="settings-hud">
                        <LostCyberHamster.UI.SharedHomeButton class="settings-hud__home" />
                        <LostCyberHamster.UI.SharedCoinsButton class="settings-hud__coins" />
                        <LostCyberHamster.UI.SharedGemsButton class="settings-hud__gems" />
                    </LostCyberHamster.UI.SharedHudLane>

                    <engine:VisualElement class="settings-title" picking-mode="Ignore" />

                    <engine:VisualElement class="settings-panel">
                        <engine:ScrollView name="settings__scroll-view" class="settings-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
                            <engine:VisualElement name="settings__content" class="settings-content">
                                <engine:VisualElement class="settings-row settings-row--language">
                                    <Vues.GameCore.LocalizedLabel key="lbl_language" class="settings-row__label" />
                                    <engine:DropdownField name="settings__dd-languages" class="settings-language" choices="ENGLISH,РУССКИЙ" index="0" />
                                </engine:VisualElement>

                                <engine:VisualElement class="settings-row">
                                    <Vues.GameCore.LocalizedLabel key="lbl_music" class="settings-row__label" />
                                    <engine:VisualElement name="settings__music-checkbox" class="settings-checkbox">
                                        <engine:Toggle name="settings__cbx-music" class="settings-checkbox__native" />
                                        <engine:VisualElement class="settings-checkbox__base" picking-mode="Ignore" />
                                        <engine:VisualElement class="settings-checkbox__fill" picking-mode="Ignore" />
                                        <engine:VisualElement class="settings-checkbox__check" picking-mode="Ignore">
                                            <engine:VisualElement class="settings-checkbox__check-stroke settings-checkbox__check-stroke--short" picking-mode="Ignore" />
                                            <engine:VisualElement class="settings-checkbox__check-stroke settings-checkbox__check-stroke--long" picking-mode="Ignore" />
                                        </engine:VisualElement>
                                    </engine:VisualElement>
                                </engine:VisualElement>

                                <engine:VisualElement class="settings-row">
                                    <Vues.GameCore.LocalizedLabel key="lbl_sound" class="settings-row__label" />
                                    <engine:VisualElement name="settings__sound-checkbox" class="settings-checkbox">
                                        <engine:Toggle name="settings__cbx-sound" class="settings-checkbox__native" />
                                        <engine:VisualElement class="settings-checkbox__base" picking-mode="Ignore" />
                                        <engine:VisualElement class="settings-checkbox__fill" picking-mode="Ignore" />
                                        <engine:VisualElement class="settings-checkbox__check" picking-mode="Ignore">
                                            <engine:VisualElement class="settings-checkbox__check-stroke settings-checkbox__check-stroke--short" picking-mode="Ignore" />
                                            <engine:VisualElement class="settings-checkbox__check-stroke settings-checkbox__check-stroke--long" picking-mode="Ignore" />
                                        </engine:VisualElement>
                                    </engine:VisualElement>
                                </engine:VisualElement>

                                <engine:VisualElement class="settings-row settings-row--account">
                                    <Vues.GameCore.LocalizedLabel key="lbl_account" class="settings-row__label settings-row__label--top" />
                                    <engine:VisualElement class="settings-account">
                                        <engine:Label name="settings__lbl-account-state" class="settings-value settings-account__state" />
                                        <Vues.GameCore.LocalizedButton key="btn_link_account" name="settings__btn-link-account" class="lcs_btn settings-art-button settings-art-button--primary settings-account__button" />
                                    </engine:VisualElement>
                                </engine:VisualElement>

                                <engine:VisualElement name="settings__player-name" class="settings-row settings-row--player">
                                    <Vues.GameCore.LocalizedLabel key="lbl_player_name" class="settings-row__label" />
                                    <engine:VisualElement name="settings__player-name-view" class="settings-player-name">
                                        <engine:Label name="settings__lbl-player-name" class="settings-value settings-player-name__value" />
                                        <Vues.GameCore.LocalizedButton key="btn_change_player_name" name="settings__btn-change-player-name" class="lcs_btn settings-art-button settings-art-button--primary settings-player-name__button" />
                                    </engine:VisualElement>
                                </engine:VisualElement>

                                <engine:VisualElement name="settings__cloud-sync-status" class="settings-row settings-row--cloud">
                                    <Vues.GameCore.LocalizedLabel key="lbl_cloud_save" class="settings-row__label settings-row__label--compact" />
                                    <engine:Label name="settings__lbl-cloud-sync-status" class="settings-value" />
                                </engine:VisualElement>

                                <engine:VisualElement class="settings-row settings-row--training">
                                    <Vues.GameCore.LocalizedLabel key="settings_training" class="settings-row__label" />
                                    <Vues.GameCore.LocalizedButton key="settings_start_training" name="settings__btn-start-training" class="lcs_btn settings-art-button settings-art-button--primary settings-training-button" />
                                </engine:VisualElement>

                                <engine:VisualElement class="settings-row settings-row--version">
                                    <Vues.GameCore.LocalizedLabel key="lbl_version" class="settings-row__label" />
                                    <engine:Label name="settings__lbl-version" class="settings-value" />
                                </engine:VisualElement>
                            </engine:VisualElement>
                        </engine:ScrollView>
                    </engine:VisualElement>

                    <engine:Button name="btn_back" class="settings-image-button settings-back" />

                    <engine:VisualElement name="settings__player-name-edit" class="settings-name-overlay">
                        <engine:VisualElement class="settings-name-overlay__dim" picking-mode="Position" />
                        <engine:VisualElement name="settings-name-scale-frame" class="settings-name-scale-frame" picking-mode="Ignore">
                            <engine:VisualElement name="settings-name-design" class="settings-name-design">
                                <engine:VisualElement class="settings-name-dialog">
                                    <Vues.GameCore.LocalizedLabel key="player_name_edit_title" class="settings-name-dialog__title" />
                                    <Vues.GameCore.LocalizedLabel key="lbl_player_name" class="settings-name-dialog__label" />
                                    <engine:TextField name="settings__txt-player-name" class="settings-name-dialog__input" max-length="16" />
                                    <Vues.GameCore.LocalizedLabel key="player_name_validation_error" name="settings__lbl-player-name-error" class="settings-name-dialog__error" />
                                    <engine:VisualElement class="settings-name-dialog__actions">
                                        <Vues.GameCore.LocalizedButton key="btn_save_player_name" name="settings__btn-save-player-name" class="lcs_btn settings-art-button settings-art-button--primary settings-name-dialog__button" />
                                        <Vues.GameCore.LocalizedButton key="btn_cancel_player_name" name="settings__btn-cancel-player-name" class="lcs_btn settings-art-button settings-art-button--secondary settings-name-dialog__button settings-name-dialog__button--cancel" />
                                    </engine:VisualElement>
                                </engine:VisualElement>
                            </engine:VisualElement>
                        </engine:VisualElement>
                    </engine:VisualElement>

                    <engine:VisualElement class="settings-hidden-legacy">
                        <engine:Toggle name="settings__cbx-vibrate" />
                        <engine:Label name="settings__lbl-id" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
