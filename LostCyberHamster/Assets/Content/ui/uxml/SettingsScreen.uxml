<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Toolbar" src="project://database/Assets/Content/ui/uxml/Toolbar.uxml?fileID=9197481963319205126&amp;guid=38c97778b054b40eea03359bced8b048&amp;type=3#Toolbar" />
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="settingsscreen" style="flex-grow: 1; min-width: 0; min-height: 0;">
        <engine:Instance template="Toolbar" name="toolbar" style="flex-grow: 0; flex-shrink: 0; height: 120px;" />
        <engine:VisualElement name="settings__body" style="flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; padding-top: 16px; padding-right: 32px; padding-bottom: 16px; padding-left: 32px;">
            <Vues.GameCore.LocalizedLabel key="settings_title" class="lcs-text" style="flex-grow: 0; flex-shrink: 0; width: 100%; height: 64px; margin-bottom: 8px; font-size: 52px; -unity-text-align: middle-center;" />
            <engine:ScrollView name="settings__scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" style="flex-grow: 1; flex-shrink: 1; min-width: 0; min-height: 0; width: 100%;">
                <engine:VisualElement name="settings__content" style="width: 90%; max-width: 1120px; min-width: 0; align-self: center; align-items: stretch; justify-content: flex-start; padding-top: 8px; padding-bottom: 24px;">
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: center;">
                        <Vues.GameCore.LocalizedLabel key="lbl_language" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal;" />
                        <engine:DropdownField name="settings__dd-languages" choices="ENGLISH,РУССКИЙ" index="0" style="width: 100%; max-width: 760px; min-width: 0; flex-grow: 1; flex-shrink: 1;" />
                    </engine:VisualElement>
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: center;">
                        <Vues.GameCore.LocalizedLabel key="lbl_music" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal;" />
                        <engine:Toggle name="settings__cbx-music" />
                    </engine:VisualElement>
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: center;">
                        <Vues.GameCore.LocalizedLabel key="lbl_sound" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal;" />
                        <engine:Toggle name="settings__cbx-sound" />
                    </engine:VisualElement>
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; display: none;">
                        <Vues.GameCore.LocalizedLabel key="lbl_vibrate" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal;" />
                        <engine:Toggle name="settings__cbx-vibrate" />
                    </engine:VisualElement>
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; display: none;">
                        <Vues.GameCore.LocalizedLabel key="lbl_id" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal;" />
                        <engine:Label name="settings__lbl-id" class="lcs-text" style="width: 100%; max-width: 760px; min-width: 0; flex-grow: 1; flex-shrink: 1; white-space: normal;" />
                    </engine:VisualElement>
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: flex-start;">
                        <Vues.GameCore.LocalizedLabel key="lbl_account" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; margin-top: 12px; white-space: normal;" />
                        <engine:VisualElement style="width: 100%; max-width: 760px; min-width: 0; flex-grow: 1; flex-shrink: 1;">
                            <engine:Label name="settings__lbl-account-state" class="lcs-text" style="width: 100%; min-width: 0; white-space: normal; font-size: 24px; color: rgb(0, 0, 0); -unity-text-outline-width: 0px;" />
                            <Vues.GameCore.LocalizedButton key="btn_link_account" name="settings__btn-link-account" class="lcs_btn bg-primary" style="width: 240px; height: 52px; font-size: 22px; margin-top: 4px; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement name="settings__player-name" class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: flex-start;">
                        <Vues.GameCore.LocalizedLabel key="lbl_player_name" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; margin-top: 12px; white-space: normal;" />
                        <engine:VisualElement style="width: 100%; max-width: 760px; min-width: 0; flex-grow: 1; flex-shrink: 1;">
                            <engine:VisualElement name="settings__player-name-view" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: center;">
                                <engine:Label name="settings__lbl-player-name" class="lcs-text" style="min-width: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: 24px; color: rgb(0, 0, 0); -unity-text-outline-width: 0px;" />
                                <Vues.GameCore.LocalizedButton key="btn_change_player_name" name="settings__btn-change-player-name" class="lcs_btn bg-primary" style="width: 240px; height: 52px; flex-grow: 0; flex-shrink: 0; font-size: 22px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 12px;" />
                            </engine:VisualElement>
                            <engine:VisualElement name="settings__player-name-edit" style="width: 100%; min-width: 0; flex-grow: 0; display: none;">
                                <engine:VisualElement style="width: 100%; min-width: 0; flex-grow: 0;">
                                    <engine:TextField name="settings__txt-player-name" max-length="16" style="width: 100%; max-width: 560px; min-width: 0; height: 52px; flex-grow: 0; flex-shrink: 1; font-size: 22px;" />
                                    <engine:VisualElement style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px;">
                                        <Vues.GameCore.LocalizedButton key="btn_save_player_name" name="settings__btn-save-player-name" class="lcs_btn bg-primary" style="width: 220px; height: 52px; flex-grow: 0; flex-shrink: 0; font-size: 22px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 12px;" />
                                        <Vues.GameCore.LocalizedButton key="btn_cancel_player_name" name="settings__btn-cancel-player-name" class="lcs_btn bg-danger" style="width: 160px; height: 52px; flex-grow: 0; flex-shrink: 0; font-size: 22px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 12px;" />
                                    </engine:VisualElement>
                                </engine:VisualElement>
                                <Vues.GameCore.LocalizedLabel key="player_name_validation_error" name="settings__lbl-player-name-error" class="lcs-text" style="display: none; width: 100%; min-width: 0; margin-top: 8px; white-space: normal; font-size: 22px; color: rgb(180, 32, 32); -unity-text-outline-width: 0px;" />
                            </engine:VisualElement>
                        </engine:VisualElement>
                    </engine:VisualElement>
                    <engine:VisualElement name="settings__cloud-sync-status" class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: flex-start; display: none;">
                        <Vues.GameCore.LocalizedLabel key="lbl_cloud_save" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal; font-size: 28px;" />
                        <engine:Label name="settings__lbl-cloud-sync-status" class="lcs-text" style="width: 100%; max-width: 760px; min-width: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; font-size: 24px; color: rgb(0, 0, 0); -unity-text-outline-width: 0px;" />
                    </engine:VisualElement>
                    <engine:VisualElement class="mb-12" style="width: 100%; min-width: 0; flex-grow: 0; flex-direction: row; align-items: center;">
                        <Vues.GameCore.LocalizedLabel key="lbl_version" class="lcs-text" style="width: 300px; flex-grow: 0; flex-shrink: 0; white-space: normal;" />
                        <engine:Label name="settings__lbl-version" class="lcs-text" style="width: 100%; max-width: 760px; min-width: 0; flex-grow: 1; flex-shrink: 1; white-space: normal;" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:ScrollView>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
