<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="gamescreen" style="flex-grow: 1;">
        <engine:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: space-between; align-items: center; margin-top: 12px;">
            <LostCyberHamster.UI.Energybar />
            <engine:VisualElement style="flex-grow: 0; flex-shrink: 1; flex-direction: row; justify-content: flex-end; align-items: center; min-width: 0;">
                <engine:Label text="0" name="run-score" class="lcs-text ui-text" style="flex-grow: 0; flex-shrink: 1; min-width: 120px; max-width: 240px; font-size: 52px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-right;" />
                <engine:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 20px;" />
                <LostCyberHamster.UI.Healthbar style="flex-grow: 0; flex-shrink: 0; flex-direction: row; width: 210px; min-width: 210px; height: 70px;" />
                <engine:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 20px;" />
                <Vues.GameCore.LocalizedButton key="btn_pause" name="btn_pause" class="lcs_btn ui-surface ui-bordered" style="margin-top: 12px; margin-right: 12px; margin-bottom: 12px; margin-left: 0; width: 200px; height: 100px;" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:Button text="S" name="btn_ultra" class="ui-surface ui-bordered ui-text" style="position: absolute; right: 80px; bottom: 348px; width: 200px; height: 200px; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px; font-size: 64px; -unity-font-style: bold;" />
        <engine:Button text="J" name="btn_jump" class="ui-surface ui-bordered ui-text" style="position: absolute; right: 48px; bottom: 48px; width: 260px; height: 260px; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; border-top-left-radius: 260px; border-top-right-radius: 260px; border-bottom-right-radius: 260px; border-bottom-left-radius: 260px; font-size: 96px; -unity-font-style: bold;" />
        <engine:Label text="Label" name="hamster-state-debug-label" class="lcs-text ui-text-plain" style="-unity-text-align: upper-center; bottom: 0; position: absolute; font-size: 30px; -unity-text-outline-width: 0px;" />
        <engine:VisualElement name="tap" style="position: absolute; left: 0; bottom: 0; border-left-color: rgba(0, 0, 0, 0.4); border-right-color: rgba(0, 0, 0, 0.4); border-top-color: rgba(0, 0, 0, 0.4); border-bottom-color: rgba(0, 0, 0, 0.4); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
        <engine:Button text="BU" name="btn_buy_ulta" class="ui-surface ui-bordered ui-text" style="position: absolute; right: 0; bottom: 0; width: 140px; height: 140px; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px; font-size: 64px; -unity-font-style: bold; left: 20px; top: 380px;" />
        <engine:Button text="BE" name="btn_buy_energy" class="ui-energy-surface ui-bordered ui-text" style="position: absolute; right: 0; bottom: 0; width: 140px; height: 140px; border-top-width: 16px; border-right-width: 16px; border-bottom-width: 16px; border-left-width: 16px; border-top-left-radius: 200px; border-top-right-radius: 200px; border-bottom-right-radius: 200px; border-bottom-left-radius: 200px; font-size: 64px; -unity-font-style: bold; left: 20px; top: 200px;" />
    </engine:VisualElement>
</engine:UXML>
