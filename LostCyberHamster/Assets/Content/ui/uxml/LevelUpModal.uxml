<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/components/reward-modals.uss" />
    <Style src="../styles/LevelUpModal.uss" />
    <engine:VisualElement class="reward-modal level-up-modal">
        <engine:VisualElement name="reward-modal-viewport" class="reward-modal__viewport" picking-mode="Ignore">
            <engine:VisualElement name="reward-modal-frame" class="reward-modal__frame" picking-mode="Ignore">
                <engine:VisualElement name="reward-modal-design" class="reward-modal__design" picking-mode="Ignore">
                    <engine:VisualElement class="reward-modal__panel" picking-mode="Ignore" />
                    <engine:Label name="level-up-title" class="reward-modal__text reward-modal__title" picking-mode="Ignore" />
                    <engine:VisualElement class="level-up-modal__emblem" picking-mode="Ignore" />
                    <engine:Label name="level-up-transition" class="reward-modal__text level-up-modal__transition" picking-mode="Ignore" />
                    <engine:Label name="level-up-development-reward" class="reward-modal__text level-up-modal__development-reward" picking-mode="Ignore" />
                    <engine:Button name="btn_level_up_ok" class="reward-modal__text reward-modal__primary" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
