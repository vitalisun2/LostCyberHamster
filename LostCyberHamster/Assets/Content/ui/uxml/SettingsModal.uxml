<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="VisualElement" style="flex-grow: 1; align-self: auto; margin-top: 24px;">
        <engine:ScrollView name="settings__scroll-view" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" style="flex-grow: 1; flex-shrink: 1;">
            <engine:VisualElement style="align-items: flex-start; justify-content: flex-start; padding-bottom: 12px;">
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row; align-self: auto;">
                    <Vues.GameCore.LocalizedLabel key="lbl_language" class="lcs-text w-px-320" />
                    <engine:DropdownField name="settings__dd-languages" choices="ENGLISH,РУССКИЙ" index="0" class="w-px-480" style="flex-grow: 0;" />
                </engine:VisualElement>
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row;">
                    <Vues.GameCore.LocalizedLabel key="lbl_music" class="lcs-text w-px-320" />
                    <engine:Toggle name="settings__cbx-music" />
                </engine:VisualElement>
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row;">
                    <Vues.GameCore.LocalizedLabel key="lbl_sound" class="lcs-text w-px-320" />
                    <engine:Toggle name="settings__cbx-sound" />
                </engine:VisualElement>
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row; display: none;">
                    <Vues.GameCore.LocalizedLabel key="lbl_vibrate" class="lcs-text w-px-320" />
                    <engine:Toggle name="settings__cbx-vibrate" />
                </engine:VisualElement>
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row; display: none;">
                    <Vues.GameCore.LocalizedLabel key="lbl_id" class="lcs-text w-px-320" />
                    <engine:Label name="settings__lbl-id" class="lcs-text w-px-480" />
                </engine:VisualElement>
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row; align-items: flex-start;">
                    <Vues.GameCore.LocalizedLabel key="lbl_account" class="lcs-text w-px-320" style="margin-top: 32px;" />
                    <engine:VisualElement style="width: 480px; flex-grow: 0;">
                        <engine:Label name="settings__lbl-account-state" class="lcs-text" style="width: 480px; white-space: normal; font-size: 24px; color: rgb(0, 0, 0); -unity-text-outline-width: 0px;" />
                        <Vues.GameCore.LocalizedButton key="btn_link_account" name="settings__btn-link-account" class="lcs_btn bg-primary" style="width: 240px; height: 52px; font-size: 22px; margin-top: 4px; margin-right: 0; margin-bottom: 0; margin-left: 0;" />
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="settings__player-name" class="mb-12" style="flex-grow: 0; flex-direction: row; align-items: flex-start;">
                    <Vues.GameCore.LocalizedLabel key="lbl_player_name" class="lcs-text w-px-320" style="margin-top: 12px;" />
                    <engine:VisualElement style="width: 760px; flex-grow: 0;">
                        <engine:VisualElement name="settings__player-name-view" style="width: 760px; flex-grow: 0; flex-direction: row; align-items: center;">
                            <engine:Label name="settings__lbl-player-name" class="lcs-text" style="width: 480px; white-space: normal; font-size: 24px; color: rgb(0, 0, 0); -unity-text-outline-width: 0px;" />
                            <Vues.GameCore.LocalizedButton key="btn_change_player_name" name="settings__btn-change-player-name" class="lcs_btn bg-primary" style="width: 240px; height: 52px; font-size: 22px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 12px;" />
                        </engine:VisualElement>
                        <engine:VisualElement name="settings__player-name-edit" style="width: 760px; flex-grow: 0; display: none;">
                            <engine:VisualElement style="width: 760px; flex-grow: 0; flex-direction: row; align-items: center;">
                                <engine:TextField name="settings__txt-player-name" max-length="16" style="width: 300px; height: 52px; font-size: 22px; flex-grow: 0;" />
                                <Vues.GameCore.LocalizedButton key="btn_save_player_name" name="settings__btn-save-player-name" class="lcs_btn bg-primary" style="width: 240px; height: 52px; font-size: 22px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 12px;" />
                                <Vues.GameCore.LocalizedButton key="btn_cancel_player_name" name="settings__btn-cancel-player-name" class="lcs_btn bg-danger" style="width: 160px; height: 52px; font-size: 22px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 12px;" />
                            </engine:VisualElement>
                            <Vues.GameCore.LocalizedLabel key="player_name_validation_error" name="settings__lbl-player-name-error" class="lcs-text" style="display: none; width: 760px; margin-top: 8px; white-space: normal; font-size: 22px; color: rgb(180, 32, 32); -unity-text-outline-width: 0px;" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
                <engine:VisualElement name="settings__cloud-sync-status" class="mb-12" style="flex-grow: 0; flex-direction: row; align-items: flex-start; display: none;">
                    <Vues.GameCore.LocalizedLabel key="lbl_cloud_save" class="lcs-text w-px-320" style="white-space: normal; font-size: 28px;" />
                    <engine:Label name="settings__lbl-cloud-sync-status" class="lcs-text w-px-480" style="white-space: normal; font-size: 24px; color: rgb(0, 0, 0); -unity-text-outline-width: 0px;" />
                </engine:VisualElement>
                <engine:VisualElement class="mb-12" style="flex-grow: 0; flex-direction: row;">
                    <Vues.GameCore.LocalizedLabel key="lbl_version" class="lcs-text w-px-320" />
                    <engine:Label name="settings__lbl-version" class="lcs-text w-px-480" />
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:ScrollView>
        <engine:VisualElement style="flex-grow: 0; flex-shrink: 0; flex-direction: row; justify-content: center; align-items: center;">
            <Vues.GameCore.LocalizedButton key="btn_cancel" name="settings__btn-cancel" class="lcs_btn bg-danger w-px-380" />
            <Vues.GameCore.LocalizedButton key="btn_save" name="settings__btn-save" class="lcs_btn bg-primary w-px-380" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
