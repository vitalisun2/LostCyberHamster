<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="account-prompt-modal__content" class="account-prompt">
        <Vues.GameCore.LocalizedLabel key="account_prompt_title" name="account-prompt-modal__title" class="account-prompt__title" />
        <engine:VisualElement class="account-prompt__body-panel">
            <Vues.GameCore.LocalizedLabel key="account_prompt_body" name="account-prompt-modal__body" class="account-prompt__body" />
        </engine:VisualElement>
        <engine:VisualElement class="account-prompt__actions">
            <Vues.GameCore.LocalizedButton key="btn_account_prompt_link" name="account-prompt-modal__btn-link-account" class="lcs_btn account-prompt__button account-prompt__button--primary" />
            <Vues.GameCore.LocalizedButton key="btn_later" name="account-prompt-modal__btn-later" class="lcs_btn account-prompt__button account-prompt__button--secondary" />
        </engine:VisualElement>
        <Vues.GameCore.LocalizedLabel key="account_prompt_later_message" name="account-prompt-modal__later-message" class="account-prompt-later-message" />
    </engine:VisualElement>
</engine:UXML>
