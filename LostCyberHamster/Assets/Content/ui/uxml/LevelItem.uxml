<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <engine:VisualElement name="level-item" class="level-card">
        <engine:Label name="level-item__name" class="level-card__title" picking-mode="Ignore" />
        <engine:VisualElement name="level-item__image" class="level-card__image" picking-mode="Ignore" />
        <engine:VisualElement name="level-item__lock" class="level-card__lock" picking-mode="Ignore" />
        <engine:VisualElement name="level-item__stars-container" class="level-card__stars" picking-mode="Ignore">
            <engine:VisualElement name="star1" class="level-card__star" picking-mode="Ignore" />
            <engine:VisualElement name="star2" class="level-card__star" picking-mode="Ignore" />
            <engine:VisualElement name="star3" class="level-card__star" picking-mode="Ignore" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
