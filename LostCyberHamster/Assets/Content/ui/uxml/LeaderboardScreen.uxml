<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Toolbar" src="project://database/Assets/Content/ui/uxml/Toolbar.uxml?fileID=9197481963319205126&amp;guid=38c97778b054b40eea03359bced8b048&amp;type=3#Toolbar" />
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/screens/LeaderboardScreen.uss" />
    <engine:VisualElement name="leaderboard-screen" class="leaderboard-screen main-screen">
        <engine:VisualElement name="leaderboard__viewport" class="leaderboard-viewport main-screen-body main-screen-body--below-hud">
            <engine:VisualElement name="leaderboard__scale-frame" class="leaderboard-scale-frame">
                <engine:VisualElement name="leaderboard__design" class="leaderboard-design">
                    <engine:VisualElement class="leaderboard-actions">
                        <Vues.GameCore.LocalizedButton key="leaderboard_rules_open" name="leaderboard__btn-rules" class="leaderboard-image-button leaderboard-action-button leaderboard-action-button--rules" />
                        <engine:Button name="leaderboard__btn-play" class="leaderboard-image-button leaderboard-action-button leaderboard-action-button--play" />
                    </engine:VisualElement>
                    <engine:VisualElement class="leaderboard-center">
                        <engine:VisualElement class="leaderboard-center__art" picking-mode="Ignore" />

                        <engine:Button name="leaderboard__location-previous" tooltip="Previous location" class="leaderboard-image-button leaderboard-location-button leaderboard-location-button--previous" />
                        <engine:Label name="leaderboard__location-title" class="leaderboard-runtime-text leaderboard-location-title" />
                        <engine:Button name="leaderboard__location-next" tooltip="Next location" class="leaderboard-image-button leaderboard-location-button leaderboard-location-button--next" />

                        <engine:VisualElement class="leaderboard-time-row">
                            <engine:VisualElement class="leaderboard-time-slot">
                                <Vues.GameCore.LocalizedButton key="leaderboard_morning" name="leaderboard__part-morning" class="leaderboard-image-button leaderboard-time-button leaderboard-time-button--morning">
                                    <engine:VisualElement class="leaderboard-time-button__icon leaderboard-time-button__icon--morning" picking-mode="Ignore" />
                                </Vues.GameCore.LocalizedButton>
                            </engine:VisualElement>
                            <engine:VisualElement class="leaderboard-time-slot">
                                <Vues.GameCore.LocalizedButton key="leaderboard_afternoon" name="leaderboard__part-afternoon" class="leaderboard-image-button leaderboard-time-button leaderboard-time-button--day">
                                    <engine:VisualElement class="leaderboard-time-button__icon leaderboard-time-button__icon--day" picking-mode="Ignore" />
                                </Vues.GameCore.LocalizedButton>
                            </engine:VisualElement>
                            <engine:VisualElement class="leaderboard-time-slot">
                                <Vues.GameCore.LocalizedButton key="leaderboard_evening" name="leaderboard__part-evening" class="leaderboard-image-button leaderboard-time-button leaderboard-time-button--evening">
                                    <engine:VisualElement class="leaderboard-time-button__icon leaderboard-time-button__icon--evening" picking-mode="Ignore" />
                                </Vues.GameCore.LocalizedButton>
                            </engine:VisualElement>
                            <engine:VisualElement class="leaderboard-time-slot">
                                <Vues.GameCore.LocalizedButton key="leaderboard_night" name="leaderboard__part-night" class="leaderboard-image-button leaderboard-time-button leaderboard-time-button--night">
                                    <engine:VisualElement class="leaderboard-time-button__icon leaderboard-time-button__icon--night" picking-mode="Ignore" />
                                </Vues.GameCore.LocalizedButton>
                            </engine:VisualElement>
                        </engine:VisualElement>

                        <engine:VisualElement class="leaderboard-table">
                            <engine:VisualElement class="leaderboard-table__header">
                                <Vues.GameCore.LocalizedLabel key="leaderboard_rank" class="leaderboard-runtime-text leaderboard-table__rank" />
                                <Vues.GameCore.LocalizedLabel key="leaderboard_player" class="leaderboard-runtime-text leaderboard-table__player" />
                                <Vues.GameCore.LocalizedLabel key="leaderboard_score" class="leaderboard-runtime-text leaderboard-table__score" />
                            </engine:VisualElement>
                            <engine:VisualElement class="leaderboard-table__body">
                                <engine:VisualElement name="leaderboard__status" class="leaderboard-status">
                                    <engine:VisualElement class="leaderboard-status__row">
                                        <engine:Label name="leaderboard__period" class="leaderboard-runtime-text leaderboard-status__text leaderboard-status__period" />
                                        <engine:Button name="leaderboard__btn-refresh" class="leaderboard-image-button leaderboard-status__button" />
                                    </engine:VisualElement>
                                    <engine:VisualElement name="leaderboard__connection" class="leaderboard-status__row">
                                        <engine:Label name="leaderboard__connection-text" class="leaderboard-runtime-text leaderboard-status__text" />
                                    </engine:VisualElement>
                                    <engine:VisualElement name="leaderboard__participation" class="leaderboard-status__row">
                                        <engine:Label name="leaderboard__participation-text" class="leaderboard-runtime-text leaderboard-status__text" />
                                        <engine:Button name="leaderboard__btn-participation" class="leaderboard-image-button leaderboard-status__button leaderboard-status__button--wide" />
                                    </engine:VisualElement>
                                    <engine:Label name="leaderboard__personal-status" class="leaderboard-runtime-text leaderboard-status__text leaderboard-status__personal" />
                                </engine:VisualElement>
                                <Vues.GameCore.LocalizedLabel key="leaderboard_loading" name="leaderboard__loading" class="leaderboard-runtime-text leaderboard-table__message" />
                                <engine:VisualElement name="leaderboard__error" class="leaderboard-table__error">
                                    <engine:Label name="leaderboard__error-text" class="leaderboard-runtime-text leaderboard-table__error-text" />
                                    <engine:Button name="leaderboard__btn-retry" class="leaderboard-image-button leaderboard-status__button leaderboard-retry-button" />
                                </engine:VisualElement>
                                <engine:Label name="leaderboard__empty" class="leaderboard-runtime-text leaderboard-table__message" />
                                <engine:ScrollView name="leaderboard__rows" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="leaderboard-table__rows" />
                                <engine:VisualElement name="leaderboard__current-player" class="leaderboard-current-player">
                                    <engine:Label name="leaderboard__current-rank" class="leaderboard-runtime-text leaderboard-table__rank" />
                                    <engine:Label name="leaderboard__current-name" class="leaderboard-runtime-text leaderboard-table__player" />
                                    <engine:Label name="leaderboard__current-score" class="leaderboard-runtime-text leaderboard-table__score" />
                                </engine:VisualElement>
                            </engine:VisualElement>
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement class="main-screen-title main-screen-title--league" picking-mode="Ignore" />
        <engine:Instance template="Toolbar" name="toolbar" class="main-screen-hud" />
        <engine:VisualElement name="leaderboard__rules-overlay" class="leaderboard-rules-overlay">
            <engine:VisualElement name="leaderboard__rules-backdrop" class="leaderboard-rules-backdrop" />
            <engine:VisualElement name="leaderboard__rules-frame" class="leaderboard-rules-frame">
                <engine:VisualElement name="leaderboard__rules-design" class="leaderboard-rules-design">
                    <engine:VisualElement name="leaderboard__rules-panel" class="leaderboard-rules-panel">
                        <Vues.GameCore.LocalizedLabel key="leaderboard_rules_title" class="leaderboard-rules-text leaderboard-rules-title" />
                        <engine:ScrollView name="leaderboard__rules-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="leaderboard-rules-scroll">
                            <Vues.GameCore.LocalizedLabel key="leaderboard_rules_intro" class="leaderboard-rules-text leaderboard-rules-paragraph" />
                            <Vues.GameCore.LocalizedLabel key="leaderboard_rules_scoring_title" class="leaderboard-rules-text leaderboard-rules-section-title" />
                            <engine:Label name="leaderboard__rules-coin" class="leaderboard-rules-text" />
                            <engine:Label name="leaderboard__rules-collectibles" class="leaderboard-rules-text" />
                            <engine:Label name="leaderboard__rules-obstacle" class="leaderboard-rules-text" />
                            <Vues.GameCore.LocalizedLabel key="leaderboard_rules_score_note" class="leaderboard-rules-text leaderboard-rules-paragraph" />
                            <engine:Label name="leaderboard__rules-reward-title" class="leaderboard-rules-text leaderboard-rules-section-title" />
                            <Vues.GameCore.LocalizedLabel key="leaderboard_rules_reward" class="leaderboard-rules-text" />
                            <Vues.GameCore.LocalizedLabel key="leaderboard_rules_limit" class="leaderboard-rules-text leaderboard-rules-note" />
                            <Vues.GameCore.LocalizedLabel key="leaderboard_rules_profile" class="leaderboard-rules-text leaderboard-rules-paragraph" />
                        </engine:ScrollView>
                        <Vues.GameCore.LocalizedButton key="leaderboard_rules_close" name="leaderboard__rules-close" class="leaderboard-image-button leaderboard-rules-close" />
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
