<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/components/game-result-modals.uss" />
    <engine:VisualElement name="win-modal" class="game-result-modal game-result-modal--win">
        <engine:VisualElement class="game-result-modal__viewport">
            <engine:VisualElement class="game-result-modal__scale-frame">
                <engine:VisualElement class="game-result-modal__design">
                    <engine:VisualElement class="game-result-modal__panel game-result-modal__panel--win">
                        <engine:VisualElement class="game-result-modal__title game-result-modal__title--win" picking-mode="Ignore" />
                        <engine:Label name="level_context" class="game-result-modal__location-text" picking-mode="Ignore" />
                        <engine:VisualElement name="stars_container" class="game-result-modal__stars" picking-mode="Ignore">
                            <engine:VisualElement name="star1" class="game-result-modal__star game-result-modal__star--one" />
                            <engine:VisualElement name="star2" class="game-result-modal__star game-result-modal__star--two" />
                            <engine:VisualElement name="star3" class="game-result-modal__star game-result-modal__star--three" />
                        </engine:VisualElement>
                        <engine:VisualElement name="win_result" class="game-result-modal__result" picking-mode="Ignore">
                            <engine:Label name="win_run_score" class="game-result-modal__runtime-text game-result-modal__run-score" />
                            <engine:VisualElement class="game-result-modal__divider game-result-modal__divider--win" />
                            <engine:Label name="win_record" class="game-result-modal__runtime-text game-result-modal__record" />
                            <engine:Label name="win_submission_status" class="game-result-modal__runtime-text game-result-modal__submission" />
                        </engine:VisualElement>
                        <engine:Button name="btn_leaderboard" class="game-result-modal__leaderboard" />
                        <engine:Button name="btn__home" tooltip="Home" class="game-result-modal__image-button game-result-modal__home-button game-result-modal__home-button--win" />
                        <engine:Button name="btn__repeat" tooltip="Retry" class="game-result-modal__image-button game-result-modal__retry-button game-result-modal__retry-button--win" />
                        <engine:Button name="btn__play" tooltip="Next Level" class="game-result-modal__image-button game-result-modal__primary-button game-result-modal__primary-button--win" />
                        <engine:VisualElement name="first-session-win-goal" style="position: absolute; left: 70px; top: 492px; width: 642px; height: 48px; flex-direction: row; align-items: center; display: none;">
                            <engine:Label name="first-session-win-goal-text" picking-mode="Ignore" style="width: 474px; height: 48px; margin: 0; padding: 0; font-size: 17px; white-space: normal; -unity-font-style: bold; -unity-text-align: middle-left; color: rgb(15, 42, 80);" />
                            <engine:Button name="btn_first-session-goal" style="width: 156px; height: 44px; margin: 0; margin-left: 12px; padding: 4px; white-space: normal; font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; color: rgb(15, 42, 80); background-color: rgb(224, 238, 246); border-color: rgb(37, 97, 141); border-width: 1px; border-radius: 8px;" />
                        </engine:VisualElement>
                    </engine:VisualElement>
                </engine:VisualElement>
            </engine:VisualElement>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
