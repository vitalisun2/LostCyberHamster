<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Template name="Toolbar" src="project://database/Assets/Content/ui/uxml/Toolbar.uxml?fileID=9197481963319205126&amp;guid=38c97778b054b40eea03359bced8b048&amp;type=3#Toolbar" />
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/components/dual-tabs.uss" />
    <engine:VisualElement name="quests-viewport" class="quests-viewport">
      <engine:VisualElement name="quests-scale-frame" class="quests-scale-frame">
       <engine:VisualElement name="questsscreen" class="quests-screen main-screen">
        <engine:VisualElement name="quests-daily-rule-panel" class="quests-daily-rule-panel" picking-mode="Ignore">
            <engine:VisualElement class="quests-daily-rule-icon" />
            <Vues.GameCore.LocalizedLabel key="retention_daily_rule" name="quests-daily-rule" class="quests-daily-rule" />
        </engine:VisualElement>
        <engine:VisualElement name="quests-daily-bonus-panel" class="quests-daily-bonus-panel">
            <engine:VisualElement class="quests-daily-pouch" picking-mode="Ignore" />
            <engine:Label name="quests-daily-more" class="quests-daily-more" picking-mode="Ignore" />
            <engine:VisualElement class="quests-daily-tag">
                <engine:Label name="quests-daily-bonus-title" class="quests-daily-bonus-title" picking-mode="Ignore" />
                <engine:VisualElement class="quests-daily-amount-row" picking-mode="Ignore">
                    <engine:VisualElement class="quests-daily-coin" />
                    <engine:Label name="quests-daily-amount" class="quests-daily-amount" />
                </engine:VisualElement>
                <engine:VisualElement name="quests-daily-marks" class="quests-daily-marks" picking-mode="Ignore" />
                <engine:Label name="quests-daily-progress" class="quests-daily-progress" picking-mode="Ignore" />
                <engine:Button name="quests-daily-bonus" class="quests-daily-bonus" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="quests-content" class="quests-content main-screen-body" picking-mode="Ignore">
            <engine:VisualElement name="quests-tabs" class="quests-tabs dual-tabs dual-tabs--left-active">
                <engine:Button name="btn__quests-tab-daily" class="dual-tab dual-tab--left">
                    <Vues.GameCore.LocalizedLabel key="quests_tab_daily" class="dual-tab__label ui-text-small-white quests-tab__label" picking-mode="Ignore" />
                </engine:Button>
                <engine:Button name="btn__quests-tab-story" class="dual-tab dual-tab--right">
                    <Vues.GameCore.LocalizedLabel key="quests_tab_story" class="dual-tab__label ui-text-small-white quests-tab__label" picking-mode="Ignore" />
                </engine:Button>
            </engine:VisualElement>
            <engine:VisualElement name="quests-page" class="quests-page" picking-mode="Ignore">
                <engine:Button text="◀" name="btn__quests-prev" class="lcs_btn bg-primary carousel-nav-button carousel-nav-button--previous" />
                <engine:VisualElement name="quests_container" class="quests-container" picking-mode="Ignore" />
                <engine:Button text="▶" name="btn__quests-next" class="lcs_btn bg-primary carousel-nav-button carousel-nav-button--next" />
            </engine:VisualElement>
        </engine:VisualElement>
        <engine:VisualElement name="quests-title" class="main-screen-title main-screen-title--quests" picking-mode="Ignore" />
        <engine:Instance template="Toolbar" name="toolbar" class="main-screen-hud" />
    </engine:VisualElement>
      </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
