<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Content/ui/styles/common.uss?fileID=7433441132597879392&amp;guid=9c9b2bc833fd5406cbe3980288b9d0d5&amp;type=3#common" />
    <Style src="../styles/screens/CharacterScreen.uss" />
    <ui:VisualElement name="hero-screen" class="hero-screen">
        <ui:VisualElement name="hero-viewport" class="hero-viewport">
            <ui:VisualElement name="hero-scale-frame" class="hero-scale-frame">
                <ui:VisualElement name="hero-design" class="hero-design">
                    <ui:VisualElement class="hero-background" picking-mode="Ignore" />
                    <ui:VisualElement class="hero-title" picking-mode="Ignore" />
                    <ui:VisualElement class="hero-tabs">
                        <ui:Button name="hero-tab-skins" class="hero-tab hero-tab--skins hero-tab--active">
                            <ui:VisualElement class="hero-tab__icon hero-tab__icon--skins" picking-mode="Ignore" />
                            <Vues.GameCore.LocalizedLabel key="equipment_skins" class="hero-tab__label" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="hero-tab-abilities" class="hero-tab hero-tab--abilities">
                            <ui:VisualElement class="hero-tab__icon hero-tab__icon--abilities" picking-mode="Ignore" />
                            <Vues.GameCore.LocalizedLabel key="equipment_abilities" class="hero-tab__label" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement name="hero-skins-page" class="hero-page hero-page--skins">
                        <ui:VisualElement class="hero-preview-panel">
                            <ui:VisualElement name="hero-skin-preview-image" class="hero-skin-preview-image" picking-mode="Ignore" />
                            <ui:Label name="hero-skin-preview-name" class="hero-preview-name" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:ScrollView name="hero-skin-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="hero-slots-scroll">
                            <ui:VisualElement name="hero-skin-slots" class="hero-slots" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                    <ui:VisualElement name="hero-abilities-page" class="hero-page hero-page--abilities">
                        <ui:VisualElement class="hero-preview-panel">
                            <ui:VisualElement name="hero-ability-preview-image" class="hero-ability-preview-image" picking-mode="Ignore" />
                            <ui:Label name="hero-ability-preview-description" class="hero-ability-description" picking-mode="Ignore" />
                            <ui:Button name="hero-ability-select" class="hero-select-button" />
                        </ui:VisualElement>
                        <ui:ScrollView name="hero-ability-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" class="hero-slots-scroll">
                            <ui:VisualElement name="hero-ability-slots" class="hero-slots" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <LostCyberHamster.UI.SharedHudLane class="hero-hud">
            <ui:VisualElement class="hero-hud__left">
                <LostCyberHamster.UI.SharedHomeButton />
                <LostCyberHamster.UI.SharedCoinsButton />
                <LostCyberHamster.UI.SharedGemsButton />
            </ui:VisualElement>
            <ui:VisualElement class="hero-hud__spacer" />
            <ui:VisualElement class="hero-hud__right">
                <LostCyberHamster.UI.SharedSettingsButton />
            </ui:VisualElement>
        </LostCyberHamster.UI.SharedHudLane>
    </ui:VisualElement>
</ui:UXML>
