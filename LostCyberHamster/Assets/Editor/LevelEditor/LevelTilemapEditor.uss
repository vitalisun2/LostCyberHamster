.sprite {
    max-width: 50px;
    min-width: 50px;
    max-height: 50px;
    min-height: 50px;
    margin: 5px;
    padding: 4px;
}

.sprite:hover {
    background-color: #202020;
}

#sprites .unity-scroll-view__content-container {
    flex-direction: row;
    flex-wrap: wrap;
}

.create-level-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 8px;
    min-height: 30px;
}

.level-list-mode-btn {
    margin-left: 12px;
    min-width: 120px;
    flex-shrink: 0;
}
