#!/bin/sh

# graphify-hook-start
# Project wrapper around Graphify's post-commit hook.
# Rebuild the tracked project map, then commit only its generated output.

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0

GIT_DIR=${GIT_DIR:-$(git rev-parse --git-dir 2>/dev/null)}
[ -d "$GIT_DIR/rebase-merge" ] && exit 0
[ -d "$GIT_DIR/rebase-apply" ] && exit 0
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -f "$GIT_DIR/CHERRY_PICK_HEAD" ] && exit 0

CHANGED=$(git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD 2>/dev/null)
[ -z "$CHANGED" ] && exit 0

# A map-only commit must not start another rebuild.
NON_GRAPH=$(printf '%s\n' "$CHANGED" | grep -v '^graphify-out/' || true)
[ -z "$NON_GRAPH" ] && exit 0

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

if command -v pwsh >/dev/null 2>&1; then
    POWERSHELL=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    POWERSHELL=powershell.exe
else
    echo "[graphify hook] PowerShell not found; map rebuild skipped." >&2
    exit 0
fi

"$POWERSHELL" -NoProfile -NonInteractive -ExecutionPolicy Bypass \
    -File "$ROOT/tools/graphify_post_commit.ps1"

# The source commit already succeeded. Rebuild/auto-commit failures stay visible
# in the working tree and must not make Git report the original commit as failed.
exit 0
# graphify-hook-end
