{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Commit to Unity Live",
            "type": "shell",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File '${workspaceFolder}/tools/commit_to_unity_live.ps1'",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Codebase Compact Watcher",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/codebase_compact.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Cleanup Old Logs",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/cleanup_old_logs.ps1"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Recompile And Sync",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/invoke_recompile_and_sync.ps1"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
