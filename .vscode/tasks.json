{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Commit & Merge to Main",
            "type": "shell",
            "command": "pwsh -NoProfile -ExecutionPolicy Bypass -File '${workspaceFolder}/commit_merge.ps1'",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Codebase Compact Watcher",
            "type": "shell",
            "command": "pwsh",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/codebase_compact.ps1"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
